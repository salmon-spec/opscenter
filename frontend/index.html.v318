</head>
<body>
<div class="toast-wrap" id="toastContainer"></div>
<div id="app"></div>
<script>
const { createApp, ref, reactive, computed, onMounted, onUnmounted, watch, nextTick } = Vue;

const API = '/api/v2';
const iconMap = {code:'#fa-code',chart:'#fa-chart',tool:'#fa-tool',database:'#fa-database',globe:'#fa-globe',bolt:'#fa-bolt',box:'#fa-box',server:'#fa-server'};

createApp({
  setup() {
    const currentPage = ref(localStorage.getItem('ops_page') || 'nav');
    const darkMode = ref(true);
    const searchQuery = ref('');
    const clock = ref('');
    const collapsed = ref(false);

    // ========== Data ==========
    const groupConfig = reactive({ defaultGroups: [], servers: {}, mergedGroups: [] });
    const autoServices = ref([]);     // from /api/v2/services-with-status
    const servers = ref([]);
    const currentServerId = ref('');
    const monitorData = ref(null);
    const containers = ref([]);
    const selectedMetric = ref('cpu');
    const historyHours = ref(24);
    const historyData = ref([]);
    let echartsLib = null;
    let chartInstance = null;
    const chartBox = ref(null);
    let autoRefreshTimer = null;
    // Cache for instant display on page switch
    let monitorCache = null;    // { serverId: { monitorData, containers } }
    let historyCache = null;    // { key: { historyData } }  key = serverId:metric:hours

    // ========== Resource: Server Tab ==========
    const scanningServerId = ref(null);

    // ========== Terminal ==========
    const termTabs = ref([]);
    const termActiveId = ref('');
    const termRefs = reactive({});
    let termCounter = 0;
    const resServerId = ref('');   // selected server in resources page

    function switchResServer(sid) {
      resServerId.value = sid;
      localStorage.setItem('oc-res-server', sid);
    }

    // ========== Modals ==========
    const showGroupModal = ref(false);
    const newGroupName = ref('');
    const newGroupId = ref('');
    const newGroupColor = ref('#64748b');
    const editingGroup = ref(null);
    const editGroupName = ref('');
    const editGroupColor = ref('#64748b');
    const editGroupOrder = ref(100);
    const groupManageServerId = ref('');
    const selectedGroupIds = ref(new Set());
    const showAllGroups = ref(true);

    // ========== Resource: Service Management ==========
    const serverServices = ref({});   // { serverId: [services] }
    const showEditSvcModal = ref(false);
    const editSvcForm = reactive({ id:'', name:'', url:'', description:'', hidden:false, account:'', password:'', url_overridden:false });

    async function loadServerServices(sid) {
      try {
        const data = await apiGet(`${API}/services/all?server_id=${sid}`);
        serverServices.value[sid] = data || [];
      } catch(e) { console.warn('load services for server failed:', e.message); }
    }
    async function loadAllServerServices() {
      for (const srv of servers.value) {
        await loadServerServices(srv.id);
      }
    }
    function getSvcCount(sid) {
      const svcs = serverServices.value[sid] || [];
      const visible = svcs.filter(s => !s.hidden).length;
      const total = svcs.length;
      return { visible, total, hidden: total - visible };
    }
    async function toggleSvcHidden(svc) {
      try {
        await apiPut(`${API}/services/${svc.id}`, { hidden: !svc.hidden });
        svc.hidden = !svc.hidden;
      } catch(e) { alert('操作失败: ' + e.message); }
    }
    function openEditSvc(svc) {
      editSvcForm.id = svc.id;
      editSvcForm.name = svc.name;
      editSvcForm.url = svc.url || '';
      editSvcForm.description = svc.description || '';
      editSvcForm.hidden = svc.hidden;
      editSvcForm.account = svc.account || '';
      editSvcForm.password = svc.password || '';
      editSvcForm.url_overridden = svc.url_overridden || false;
      showEditSvcModal.value = true;
    }
    async function saveEditSvc() {
      try {
        await apiPut(`${API}/services/${editSvcForm.id}`, {
          name: editSvcForm.name,
          url: editSvcForm.url,
          description: editSvcForm.description,
          hidden: editSvcForm.hidden,
          account: editSvcForm.account,
          password: editSvcForm.password,
        });
        showEditSvcModal.value = false;
        // Reload services for all servers to reflect changes
        await loadAllServerServices();
        await loadAutoServices();
      } catch(e) { alert('保存失败: ' + e.message); }
    }

    async function resetSvcUrl(svc) {
      if (!confirm('确定要恢复自动检测的访问地址吗？')) return;
      try {
        const res = await fetch(API + '/services/' + svc.id + '/reset-url', {method:'PATCH'});
        const data = await res.json();
        if (data.ok) {
          showToast('已恢复自动地址');
          await loadAllServerServices();
          await loadAutoServices();
        }
      } catch(e) {
        showToast('恢复失败: ' + e.message);
      }
    }

    // ========== Add Server Modal ==========
    const showAddServerModal = ref(false);
    const newServer = reactive({
      name: '', host: '', ssh_port: 22, ssh_user: 'root',
      auth_type: 'password', ssh_password: '', ssh_key: '', auto_deploy_agent: true
    });
    const sshTestResult = reactive({ testing: false, success: null, message: '' });

    // ========== Edit Server Modal ==========
    const showEditServerModal = ref(false);
    const editServerForm = reactive({ id:'', name:'', host:'', ssh_port:22, ssh_user:'root', auth_type:'password', ssh_password:'', ssh_key:'' });
    const editSshTestResult = reactive({ testing: false, success: null, message: '' });



    // ========== Clock ==========
    let clockTimer;
    function updateClock() { clock.value = new Date().toLocaleTimeString('zh-CN',{hour12:false}); }

    // ========== API helpers ==========
    async function apiGet(url) { const r = await fetch(url); if (!r.ok) throw new Error(r.status); return r.json(); }
    async function apiPost(url, body) { return fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }); }
    async function apiPut(url, body) { return fetch(url, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }); }
    async function apiPatch(url) { return fetch(url, { method:'PATCH' }); }
    async function apiDelete(url) { return fetch(url, { method:'DELETE' }); }

    // ========== Agent Management ==========
    async function deployAgent(serverId) {
      if (!confirm('确定要在此服务器上部署/升级监控Agent？')) return;
      try {
        const r = await apiPost(`${API}/servers/${serverId}/deploy-agent`, {});
        const data = await r.json();
        if (data.success) {
          const scanInfo = data.scan_added ? `，自动发现${data.scan_added}个服务` : '';
          showToast((data.message || 'Agent部署/升级成功') + scanInfo, 'ok', 5000);
        } else {
          showToast('Agent部署失败: ' + (data.message || '未知错误'), 'err', 5000);
        }
        await loadServers(); await loadAllServerServices(); await loadAutoServices();
      } catch(e) { showToast('部署异常: ' + e.message, 'err'); }
    }

    async function checkAgentStatus(serverId) {
      try {
        const data = await apiGet(`${API}/servers/${serverId}/agent-status`);
        if (data.status === 'running') {
          showToast('Agent运行正常 v' + (data.agent_version||'?') + ' 端口:' + (data.agent_port||19100), 'ok');
        } else {
          showToast('Agent状态: ' + (data.status||'未知') + (data.message ? ' - ' + data.message : ''), 'warn');
        }
        await loadServers();
      } catch(e) { showToast('检查失败: ' + e.message, 'err'); }
    }

    // ========== Load groups.json via backend API ==========
    async function loadGroupConfig() {
      try {
        const [data, merged] = await Promise.all([
          apiGet(`${API}/group-config`),
          apiGet(`${API}/group-config/merged`).catch(() => [])
        ]);
        groupConfig.defaultGroups = data.defaultGroups || data.groups || [];
        groupConfig.servers = data.servers || {};
        groupConfig.mergedGroups = merged || [];
      } catch(e) { console.warn('group-config load failed:', e.message); }
    }

    // ========== Load auto services via backend API ==========
    async function loadAutoServices() {
      try {
        const data = await apiGet(`${API}/services-with-status`);
        const svcs = data.map(s => ({
          id: s.id, serverId: s.server_id, name: s.name,
          url: s.url, url_overridden: s.url_overridden || false, category: s.category, icon: s.icon,
          description: s.description, source: s.source,
          status: s.status === 'up' ? 'online' : s.status === 'down' ? 'offline' : 'unknown',
          pinned: s.pinned, containerName: s.container_name,
          image: s.image, ports: s.ports,
          serverName: s.server_name, serverHost: s.server_host,
          serverStatus: s.server_status, serverIsLocal: s.server_is_local,
          origin: 'auto',
          serviceKey: `auto:${s.server_id}:${s.id}`,
          groupId: (groupConfig.servers[s.server_id]?.serviceGroupMap || groupConfig.serviceGroupMap || {})[`auto:${s.server_id}:${s.id}`] || null,
          fullUrl: '',
        }));
        // Build fullUrl for auto services
        const proto = location.protocol;
        const Host = location.host;
        for (const s of svcs) {
          if (!s.url) { s.fullUrl = ''; continue; }
          if (s.url.startsWith('http')) { s.fullUrl = s.url; }
          else if (s.url.startsWith('/')) { s.fullUrl = `${proto}//${Host}${s.url}`; }
          else if (s.url.startsWith(':')) { s.fullUrl = `${proto}//${Host}${s.url}`; }
          else { s.fullUrl = `${proto}//${s.serverHost}${s.url.startsWith('/') ? '' : '/'}${s.url}`; }
        }
        autoServices.value = svcs;
      } catch(e) { console.warn('auto services load failed:', e.message); autoServices.value = []; }
    }

    // ========== Compute effective status ==========
    function effectiveStatus(svc) {
      if (svc.origin === 'auto' && svc.serverStatus === 'offline') return 'server_offline';
      if (svc.status === 'checking') return 'checking';
      if (svc.status === 'online') return 'online';
      if (svc.status === 'offline') return 'offline';
      return 'unknown';
    }

    // ========== Compute service groups ==========
    const navServerId = ref('');  // server filter for nav page

    const allServices = computed(() => {
      let svcs = [...autoServices.value];
      // Filter by selected server on nav page
      if (navServerId.value) {
        svcs = svcs.filter(s => s.serverId === navServerId.value);
      }
      return svcs;
    });

    // Server list with service counts for nav page
    const navServerTabs = computed(() => {
      return servers.value.map(srv => ({
        ...srv,
        serviceCount: autoServices.value.filter(s => s.serverId === srv.id).length
      }));
    });

    const mergedGroups = computed(() => {
      if (navServerId.value) {
        // Single server: use that server's groups directly
        const cfg = groupConfig.servers[navServerId.value];
        if (!cfg) return [];
        const groups = [...(cfg.groups || [])].sort((a, b) => (a.order || 100) - (b.order || 100));
        const result = [];
        for (const g of groups) {
          const svcs = allServices.value.filter(s => {
            const mapped = (cfg.serviceGroupMap || {})[s.serviceKey];
            if (mapped) return mapped === g.id;
            if (s.category) {
              const catNorm = (s.category || '').toLowerCase().replace(/[\s\-_]/g, '');
              const gNorm = (g.name || '').toLowerCase().replace(/[\s\-_]/g, '');
              if (catNorm === gNorm || catNorm.includes(gNorm) || gNorm.includes(catNorm)) return true;
            }
            return false;
          });
          if (svcs.length > 0 || g.id !== 'ungrouped') {
            result.push({ ...g, services: svcs });
          }
        }
        // ungrouped
        const ungrouped = allServices.value.filter(s => {
          const mapped = (cfg.serviceGroupMap || {})[s.serviceKey];
          if (mapped) return false;
          if (s.category) {
            const matched = result.some(g => {
              if (g.id === 'ungrouped') return false;
              const catNorm = (s.category || '').toLowerCase().replace(/[\s\-_]/g, '');
              const gNorm = (g.name || '').toLowerCase().replace(/[\s\-_]/g, '');
              return catNorm === gNorm || catNorm.includes(gNorm) || gNorm.includes(catNorm);
            });
            if (matched) return false;
          }
          return true;
        });
        if (ungrouped.length > 0) {
          const ug = result.find(g => g.id === 'ungrouped');
          if (ug) { ug.services = ungrouped; }
          else { result.push({ id: 'ungrouped', name: '未分组', order: 999, color: '#475569', icon: 'box', services: ungrouped }); }
        }
        return result;
      }
      // All servers: merge groups by name
      const map = new Map();
      for (const srv of servers.value) {
        const cfg = groupConfig.servers[srv.id];
        if (!cfg) continue;
        for (const g of (cfg.groups || [])) {
          if (!map.has(g.name)) map.set(g.name, { ...g, services: [] });
        }
      }
      for (const svc of autoServices.value) {
        const cfg = groupConfig.servers[svc.serverId];
        if (!cfg) continue;
        const groupId = (cfg.serviceGroupMap || {})[svc.serviceKey];
        if (!groupId) continue;
        const group = (cfg.groups || []).find(g => g.id === groupId);
        if (group && map.has(group.name)) {
          map.get(group.name).services.push(svc);
        }
      }
      return [...map.values()].sort((a, b) => (a.order || 100) - (b.order || 100));
    });

    const serviceGroups = computed(() => {
      // Delegate to mergedGroups which handles both single and all-server views
      return mergedGroups.value;
    });

    const filteredGroups = computed(() => {
      let groups = serviceGroups.value;
      // Apply group chip filter
      if (!showAllGroups.value) {
        groups = groups.filter(g => selectedGroupIds.value.has(g.id));
      }
      // Apply search filter
      if (!searchQuery.value) return groups;
      const q = searchQuery.value.toLowerCase();
      return groups.map(g => ({
        ...g,
        services: g.services.filter(s =>
          s.name.toLowerCase().includes(q) ||
          (s.desc || s.description || '').toLowerCase().includes(q) ||
          (s.tags || []).some(t => t.toLowerCase().includes(q))
        )
      })).filter(g => g.services.length > 0);
    });

    // ========== Stats ==========
    const stats = computed(() => {
      const all = allServices.value;
      const online = all.filter(s => effectiveStatus(s) === 'online').length;
      const offline = all.filter(s => effectiveStatus(s) === 'offline').length;
      const srvOff = all.filter(s => effectiveStatus(s) === 'server_offline').length;
      const unknown = all.filter(s => effectiveStatus(s) === 'unknown' || effectiveStatus(s) === 'checking').length;
      return { total: all.length, online, offline, srvOff, unknown };
    });

    // ========== Group management ==========
    async function addGroup() {
      if (!groupManageServerId.value) return alert('请先选择服务器');
      if (!newGroupId.value || !newGroupName.value) return;
      try {
        await apiPost(`${API}/group-config/groups?server_id=${groupManageServerId.value}`, { id: newGroupId.value, name: newGroupName.value, order: ((groupConfig.servers[groupManageServerId.value]?.groups || groupConfig.defaultGroups || []).length + 1) * 10, color: newGroupColor.value, icon: 'box' });
        newGroupId.value = ''; newGroupName.value = ''; newGroupColor.value = '#64748b';
        await loadGroupConfig();
      } catch(e) { alert('添加分组失败: ' + e.message); }
    }

    async function deleteGroup(gid) {
      if (gid === 'ungrouped') { alert('不能删除"未分组"'); return; }
      if (!confirm(`确定删除分组？映射到此分组的服务将移至"未分组"`)) return;
      try {
        await apiDelete(`${API}/group-config/groups/${gid}?server_id=${groupManageServerId.value}`);
        editingGroup.value = null;
        await loadGroupConfig();
      } catch(e) { alert('删除分组失败: ' + e.message); }
    }

    function startEditGroup(g) {
      editingGroup.value = g.id;
      editGroupName.value = g.name;
      editGroupColor.value = g.color;
      editGroupOrder.value = g.order;
    }

    function cancelEditGroup() { editingGroup.value = null; }

    async function saveEditGroup(g) {
      try {
        await fetch(`${API}/group-config/groups/${g.id}?server_id=${groupManageServerId.value}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: g.id, name: editGroupName.value, order: editGroupOrder.value, color: editGroupColor.value, icon: g.icon || 'box' })
        });
        editingGroup.value = null;
        await loadGroupConfig();
      } catch(e) { alert('修改分组失败: ' + e.message); }
    }

    async function applyDefaultGroups(serverId) {
      if (!serverId) return alert('请先选择服务器');
      try {
        await apiPost(`${API}/group-config/apply-default?server_id=${serverId}`, {});
        await loadGroupConfig();
        showToast('默认分组已应用', 'ok');
      } catch(e) { alert('应用默认分组失败: ' + e.message); }
    }

    async function moveServiceToGroup(serviceKey, groupId) {
      try {
        await fetch(`${API}/group-config/service-map?serviceKey=${encodeURIComponent(serviceKey)}&groupId=${encodeURIComponent(groupId)}`, { method: 'PATCH' });
        await loadGroupConfig();
        await loadAutoServices();
      } catch(e) { console.error('move failed:', e); }
    }

    // ========== Group Chip Filter ==========
    function toggleGroupFilter(groupId) {
      if (showAllGroups.value) {
        showAllGroups.value = false;
        selectedGroupIds.value = new Set([groupId]);
      } else {
        if (selectedGroupIds.value.has(groupId)) {
          const next = new Set(selectedGroupIds.value);
          next.delete(groupId);
          if (next.size === 0) {
            showAllGroups.value = true;
            selectedGroupIds.value = new Set();
          } else {
            selectedGroupIds.value = next;
          }
        } else {
          const next = new Set(selectedGroupIds.value);
          next.add(groupId);
          selectedGroupIds.value = next;
        }
      }
    }
    function clearGroupFilter() {
      selectedGroupIds.value = new Set();
      showAllGroups.value = true;
    }

    // ========== Copy ==========
    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(() => { fallbackCopy(text); });
      } else { fallbackCopy(text); }
    }
    function fallbackCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position='fixed'; ta.style.left='-9999px';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch(e) {}
      document.body.removeChild(ta);
    }
    function openService(url) { if(url) window.open(url,'_blank'); }

    // ========== Monitor ==========
    async function loadServers() {
      try {
        const data = await apiGet(`${API}/servers`);
        servers.value = data.servers || data || [];
        if (servers.value.length) {
          const saved = localStorage.getItem('oc-server');
          currentServerId.value = (saved && servers.value.find(s => s.id === saved)) ? saved : servers.value[0].id;
        }
      } catch(e) { console.warn('servers load failed:', e.message); }
    }

    async function loadMonitor() {
      if (!currentServerId.value) return;
      const sid = currentServerId.value;
      const srv = servers.value.find(s => s.id === sid);
      if (srv && srv.status === 'offline') { monitorData.value = null; containers.value = []; historyData.value = []; if (chartInstance) { chartInstance.clear(); } return; }
      // Show cached data instantly if available
      const cached = monitorCache && monitorCache[sid];
      if (cached) { monitorData.value = cached.monitorData; containers.value = cached.containers; }
      try {
        const data = await apiGet(`${API}/servers/${sid}/monitor`);
        if (currentServerId.value === sid) {
          monitorData.value = data;
          containers.value = data.containers || [];
          // Update cache
          if (!monitorCache) monitorCache = {};
          monitorCache[sid] = { monitorData: data, containers: data.containers || [] };
        }
      } catch(e) { console.warn('monitor load failed:', e.message); }
    }

    async function loadHistory() {
      if (!currentServerId.value) return;
      const sid = currentServerId.value;
      const hKey = `${sid}:${selectedMetric.value}:${historyHours.value}`;
      if (isCurrentServerOffline.value) { historyData.value = []; if (chartInstance) { chartInstance.clear(); } return; }
      // Show cached history instantly if available
      const cached = historyCache && historyCache[hKey];
      if (cached) {
        historyData.value = cached.historyData;
        await nextTick();
        if (!chartInstance || !chartBox.value) { await initChart(); }
        if (chartInstance) { renderChart(); }
      }
      try {
        const data = await apiGet(`${API}/servers/${sid}/history?metric=${selectedMetric.value}&hours=${historyHours.value}`);
        if (currentServerId.value === sid) {
          historyData.value = data.values || [];
          await nextTick();
          if (!chartInstance || !chartBox.value) { await initChart(); }
          if (chartInstance) { renderChart(); }
          // Update cache
          if (!historyCache) historyCache = {};
          historyCache[hKey] = { historyData: data.values || [] };
        }
      } catch(e) { console.warn('history load failed:', e.message); }
    }

    async function loadEcharts() {
      if (echartsLib) return echartsLib;
      return new Promise((resolve) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js';
        s.onload = () => { echartsLib = window.echarts; resolve(echartsLib); };
        s.onerror = () => { console.error('ECharts load failed'); resolve(null); };
        document.head.appendChild(s);
      });
    }

    async function initChart() {
      if (!echartsLib) await loadEcharts();
      if (!echartsLib || !chartBox.value) return;
      if (chartInstance) { chartInstance.dispose(); }
      chartInstance = echartsLib.init(chartBox.value, darkMode.value ? 'dark' : null);
      window.addEventListener('resize', () => chartInstance && chartInstance.resize());
    }

    function renderChart() {
      if (!chartInstance || !echartsLib) return;
      const metricLabels = {cpu:'CPU 使用率 (%)',memory:'内存使用率 (%)',disk:'磁盘使用率 (%)',net_rx:'网络入流量 (B/s)',net_tx:'网络出流量 (B/s)',load1:'系统负载 (1min)',load5:'系统负载 (5min)',load15:'系统负载 (15min)',disk_read:'磁盘读取 (B/s)',disk_write:'磁盘写入 (B/s)'};
      const colors = {cpu:'#22c55e',memory:'#3b82f6',disk:'#f59e0b',net_rx:'#8b5cf6',net_tx:'#06b6d4',load1:'#f97316',load5:'#f97316',load15:'#f97316',disk_read:'#22c55e',disk_write:'#ef4444'};
      const title = metricLabels[selectedMetric.value] || selectedMetric.value;
      const color = colors[selectedMetric.value] || '#2dd4bf';
      const h = historyData.value;
      const seriesData = Array.isArray(h) ? h.map(p => {
        if (Array.isArray(p)) return [p[0] * 1000, parseFloat(p[1])];
        const ts = p.timestamp || p.time || p.x;
        return [ts, p.value ?? p.y ?? 0];
      }) : [];
      const isDarkVal = darkMode.value;
      const axisLineColor = isDarkVal ? '#334155' : '#e2e8f0';
      const splitLineColor = isDarkVal ? '#1e293b88' : '#f1f5f9';
      const labelColor = isDarkVal ? '#94a3b8' : '#64748b';
      chartInstance.setOption({
        backgroundColor:'transparent',
        textStyle:{color:labelColor},
        grid:{left:60,right:15,top:20,bottom:32},
        tooltip:{trigger:'axis',backgroundColor:isDarkVal?'#1e293b':'#fff',borderColor:isDarkVal?'#334155':'#e2e8f0',textStyle:{color:isDarkVal?'#e2e8f0':'#1e293b',fontSize:11},
          formatter:function(params){const p=params[0];if(!p)return '';const d=new Date(p.value[0]);const ts=d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0')+':'+d.getSeconds().toString().padStart(2,'0');return ts+'<br/><b>'+title+'</b>: '+parseFloat(p.value[1]).toFixed(2);}
        },
        xAxis:{type:'time',axisLine:{lineStyle:{color:axisLineColor}},axisLabel:{fontSize:10,color:labelColor,
          formatter:function(v){const d=new Date(v);if(historyHours.value>24)return (d.getMonth()+1)+'/'+d.getDate()+' '+d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0');return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0');}
        },splitLine:{show:false},boundaryGap:false},
        yAxis:{type:'value',axisLine:{show:false},splitLine:{lineStyle:{color:splitLineColor}},axisLabel:{fontSize:10,color:labelColor}},
        series:[{type:'line',data:seriesData,smooth:true,symbol:'none',lineStyle:{width:2,color:color},
          areaStyle:{color:new echartsLib.graphic.LinearGradient(0,0,0,1,[{offset:0,color:color+'40'},{offset:1,color:color+'05'}])}
        }],
        graphic: seriesData.length === 0 ? [{
          type: 'text',
          left: 'center',
          top: 'middle',
          style: {
            text: '暂无数据',
            fontSize: 16,
            fill: isDarkVal ? '#4a5568' : '#a0aec0',
            fontFamily: 'Microsoft YaHei, sans-serif'
          }
        }] : []
      }, true);
    }

    function getMetric(key) {
      if (!monitorData.value) return null;
      const m = monitorData.value.metrics || {};
      return m[key] != null ? m[key] : null;
    }

    function formatBytes(bytes) {
      if (bytes == null || bytes === 0) return '0 B';
      const units = ['B','KB','MB','GB','TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(1) + ' ' + units[i];
    }

    function formatUptime(seconds) {
      if (seconds == null || seconds <= 0) return '-';
      const d = Math.floor(seconds / 86400);
      const h = Math.floor((seconds % 86400) / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      if (d > 0) return d + '天' + h + '小时';
      if (h > 0) return h + '小时' + m + '分';
      return m + '分钟';
    }

    function formatContainerPorts(ports) {
      if (!ports || ports === '-') return '-';
      return ports.split(',').map(p => { const m = p.trim().match(/:(\d+)$/); return m ? m[1] : p.trim(); }).filter((v, i, a) => a.indexOf(v) === i).join(', ');
    }

    const metricCards = computed(() => {
      const m = monitorData.value?.metrics || {};
      const rx = m.net_rx || 0;
      const tx = m.net_tx || 0;
      const netBps = rx + tx;
      return [
        {key:'cpu',icon:'⚡',label:'CPU',value:m.cpu||0,display:(m.cpu||0).toFixed(1)+'%',color:'#22c55e',detail:(m.cpu_count||0)+' 核心'},
        {key:'memory',icon:'💾',label:'内存',value:m.memory||0,display:(m.memory||0).toFixed(1)+'%',color:'#3b82f6',detail:formatBytes(m.memory_used)+' / '+formatBytes(m.memory_total)},
        {key:'disk',icon:'💿',label:'磁盘',value:m.disk||0,display:(m.disk||0).toFixed(1)+'%',color:'#f59e0b',detail:formatBytes(m.disk_avail)+' 可用'},
        {key:'net_rx',icon:'📥',label:'网络入',value:0,display:formatBytes(rx)+'/s',color:'#8b5cf6',detail:'接收流量'},
        {key:'net_tx',icon:'📤',label:'网络出',value:0,display:formatBytes(tx)+'/s',color:'#06b6d4',detail:'发送流量'},
        {key:'load1',icon:'📊',label:'负载',value:0,display:(m.load1||0).toFixed(2),color:'#f97316',detail:'1m/'+(m.load5||0).toFixed(2)+' 5m/'+(m.load15||0).toFixed(2)+' 15m'},
        {key:'disk_read',icon:'⬆️',label:'磁盘读',value:0,display:formatBytes(m.disk_read||0)+'/s',color:'#22c55e',detail:'读取速率'},
        {key:'disk_write',icon:'⬇️',label:'磁盘写',value:0,display:formatBytes(m.disk_write||0)+'/s',color:'#ef4444',detail:'写入速率'},
      ];
    });

    const isCurrentServerOffline = computed(() => {
      const srv = servers.value.find(s => s.id === currentServerId.value);
      return srv && srv.status === 'offline';
    });

    // ========== Add Server ==========
    async function addServer() {
      if (!newServer.name || !newServer.host) { alert('请填写服务器名称和主机地址'); return; }
      try {
        const body = {
          name: newServer.name,
          host: newServer.host,
          ssh_port: newServer.ssh_port,
          ssh_user: newServer.ssh_user,
          is_local: false,
        };
        if (newServer.auth_type === 'password') {
          body.ssh_password = newServer.ssh_password;
        } else {
          body.ssh_key = newServer.ssh_key;
        }
        const r = await apiPost(`${API}/servers`, body);
        if (r.ok || r.status === 201) {
          const respData = await r.json().catch(() => ({}));
          // Show agent deploy result if applicable
          if (respData.agent_deployed !== undefined) {
            alert(respData.agent_deployed ? '服务器添加成功，Agent已自动部署' : '服务器添加成功，Agent部署失败: ' + (respData.agent_message || ''));
          }
          showAddServerModal.value = false;
          // Reset form
          Object.assign(newServer, { name: '', host: '', ssh_port: 22, ssh_user: 'root', auth_type: 'password', ssh_password: '', ssh_key: '', auto_deploy_agent: true });
          Object.assign(sshTestResult, { testing: false, success: null, message: '' });
          await loadServers();
          await loadAllServerServices();
        } else {
          const data = await r.json().catch(() => ({}));
          alert('添加失败: ' + (data.detail || r.statusText));
        }
      } catch(e) { alert('添加失败: ' + e.message); }
    }

    async function testSsh() {
      if (!newServer.host) { alert('请填写主机地址'); return; }
      Object.assign(sshTestResult, { testing: true, success: null, message: '' });
      try {
        const body = {
          host: newServer.host,
          port: newServer.ssh_port,
          username: newServer.ssh_user,
        };
        if (newServer.auth_type === 'password') {
          body.password = newServer.ssh_password;
        } else {
          body.ssh_key = newServer.ssh_key;
        }
        const r = await apiPost(`${API}/test-ssh`, body);
        const data = await r.json();
        Object.assign(sshTestResult, { testing: false, success: data.success, message: data.message });
      } catch(e) {
        Object.assign(sshTestResult, { testing: false, success: false, message: '请求失败: ' + e.message });
      }
    }

    async function deleteServer(sid) {
      if (!confirm('确定删除此服务器？关联的服务也会被删除。')) return;
      try {
        await apiDelete(`${API}/servers/${sid}`);
        await loadServers();
        await loadAllServerServices();
      } catch(e) { alert('删除失败: ' + (e.message || '未知错误')); }
    }

    // ========== Edit Server ==========
    function openEditServer(srv) {
      const hasKey = srv.ssh_key && !srv.ssh_key.startsWith('__password__');
      Object.assign(editServerForm, {
        id: srv.id,
        name: srv.name || '',
        host: srv.host || '',
        ssh_port: srv.ssh_port || 22,
        ssh_user: srv.ssh_user || 'root',
        auth_type: hasKey ? 'key' : 'password',
        ssh_password: '',
        ssh_key: '',
      });
      Object.assign(editSshTestResult, { testing: false, success: null, message: '' });
      showEditServerModal.value = true;
    }

    async function saveEditServer() {
      if (!editServerForm.name || !editServerForm.host) { alert('请填写服务器名称和主机地址'); return; }
      try {
        const body = {
          name: editServerForm.name,
          host: editServerForm.host,
          ssh_port: editServerForm.ssh_port,
          ssh_user: editServerForm.ssh_user,
        };
        if (editServerForm.auth_type === 'password' && editServerForm.ssh_password) {
          body.ssh_password = editServerForm.ssh_password;
        } else if (editServerForm.auth_type === 'key' && editServerForm.ssh_key) {
          body.ssh_key = editServerForm.ssh_key;
        }
        await apiPut(`${API}/servers/${editServerForm.id}`, body);
        showEditServerModal.value = false;
        await loadServers();
        await loadAllServerServices();
        showToast('服务器信息已更新', 'ok');
      } catch(e) { alert('保存失败: ' + e.message); }
    }

    async function testEditSsh() {
      if (!editServerForm.host) { alert('请填写主机地址'); return; }
      Object.assign(editSshTestResult, { testing: true, success: null, message: '' });
      try {
        const body = {
          host: editServerForm.host,
          port: editServerForm.ssh_port,
          username: editServerForm.ssh_user,
        };
        if (editServerForm.auth_type === 'password') {
          body.password = editServerForm.ssh_password;
        } else {
          body.ssh_key = editServerForm.ssh_key;
        }
        const r = await apiPost(`${API}/test-ssh`, body);
        const data = await r.json();
        Object.assign(editSshTestResult, { testing: false, success: data.success, message: data.message });
      } catch(e) {
        Object.assign(editSshTestResult, { testing: false, success: false, message: '请求失败: ' + e.message });
      }
    }

    // ========== Resource ==========
    function showToast(msg, type='info', duration=3500) {
      const el = document.createElement('div');
      el.className = 'toast-msg ' + type;
      el.textContent = msg;
      document.getElementById('toastContainer').appendChild(el);
      requestAnimationFrame(() => el.classList.add('show'));
      setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 350); }, duration);
    }

    async function triggerScan(sid) {
      scanningServerId.value = sid;
      try {
        const r = await apiPost(`${API}/servers/${sid}/scan-services`);
        const data = await r.json().catch(() => ({}));
        const src = {agent:'Agent',ssh:'SSH',docker_local:'本地Docker'}[data.source] || data.source || '';
        if (data.discovered > 0) {
          showToast(`扫描完成（${src}）：新增 ${data.added||0}，更新 ${data.updated||0}`, 'ok');
        } else {
          showToast(`扫描完成（${src}）：服务无变化`, 'info');
        }
        await loadMonitor(); await loadServerServices(sid); await loadAutoServices(); await loadServers();
      } catch(e) { showToast('扫描失败：' + (e.message||'未知错误'), 'err'); }
      finally { scanningServerId.value = null; }
    }

    // ========== Init ==========
    onMounted(async () => {
      updateClock();
      clockTimer = setInterval(updateClock, 1000);
      // Preload ECharts immediately (non-blocking)
      loadEcharts();
      await loadGroupConfig();
      await Promise.all([loadAutoServices(), loadServers()]);
      await termRestore();
      const onlineSrv = servers.value.find(s => s.status === 'online');
      if (onlineSrv) navServerId.value = onlineSrv.id;
      if (servers.value.length) {
        const savedResSrv = localStorage.getItem('oc-res-server');
        if (savedResSrv && servers.value.find(s => s.id === savedResSrv)) {
          resServerId.value = savedResSrv;
        } else {
          resServerId.value = servers.value[0].id;
        }
      }
      await loadMonitor();
      await loadAllServerServices();
    });
    onUnmounted(() => { clearInterval(clockTimer); if (autoRefreshTimer) clearInterval(autoRefreshTimer); });

    // Watch server change for monitor (parallel loading)
    watch(currentServerId, async () => {
      await Promise.all([loadMonitor(), loadHistory()]);
    });
    watch(currentPage, async (val) => {
      if (val === 'monitor') {
        // Dispose stale chartInstance (v-if destroyed its DOM element)
        if (chartInstance) { try { chartInstance.dispose(); } catch(e){} chartInstance = null; }
        // Wait for Vue to recreate the monitor DOM (v-if)
        await nextTick();
        // Parallel: load data while initializing chart
        await Promise.all([loadMonitor(), loadHistory(), initChart()]);
        if (autoRefreshTimer) clearInterval(autoRefreshTimer);
        autoRefreshTimer = setInterval(loadMonitor, 15000);
      } else {
        if (autoRefreshTimer) { clearInterval(autoRefreshTimer); autoRefreshTimer = null; }
      }
    });
    watch(darkMode, () => { if (chartInstance) { initChart(); renderChart(); } });
    // Persist current page to localStorage
    watch(currentPage, (val) => { localStorage.setItem('ops_page', val); });
    // Persist current page to localStorage
    watch(currentPage, (val) => { localStorage.setItem('ops_page', val); });

    // ========== Template data ==========
      // ========== Terminal Methods ==========
    const fmShow = ref(false);
    const fmPath = ref('/');
    const fmFiles = ref([]);
    const fmLoading = ref(false);
    const fmSelected = ref('');
    const fmUploading = ref(false);
    const fmPathSegments = computed(() => fmPath.value.split('/').filter(Boolean));
    function fmPathPrefix(i) {
      return '/' + fmPathSegments.value.slice(0, i + 1).join('/');
    }
    async function fmToggle() {
      if (!termActiveId.value) { showToast('请先连接终端', 'warn'); return; }
      fmShow.value = !fmShow.value;
      if (fmShow.value && fmFiles.value.length === 0) { fmPath.value = '/'; await fmLoad(); }
    }
    async function fmLoad() {
      fmLoading.value = true;
      fmSelected.value = '';
      try {
        const resp = await fetch(API + '/terminal/sessions/' + termActiveId.value + '/files?path=' + encodeURIComponent(fmPath.value));
        if (!resp.ok) { const e = await resp.json().catch(()=>({})); showToast(e.detail || '读取目录失败', 'err'); fmLoading.value = false; return; }
        const data = await resp.json();
        fmFiles.value = data.entries || [];
      } catch(e) { showToast('读取目录失败: ' + e.message, 'err'); }
      fmLoading.value = false;
    }
    async function fmCd(path) {
      if (path === '..') {
        const parts = fmPath.value.split('/').filter(Boolean);
        parts.pop();
        fmPath.value = '/' + parts.join('/');
        if (fmPath.value === '') fmPath.value = '/';
      } else {
        fmPath.value = path === '/' ? '/' : path.replace(/\/+$/, '');
        if (fmPath.value === '') fmPath.value = '/';
      }
      await fmLoad();
    }
    function fmRefresh() { fmLoad(); }
    function fmSelect(f) { fmSelected.value = fmSelected.value === f.name ? '' : f.name; }
    async function fmOpen(f) {
      if (f.is_dir) {
        fmPath.value = fmPath.value === '/' ? '/' + f.name : fmPath.value + '/' + f.name;
        await fmLoad();
      } else {
        // Download
        try {
          const resp = await fetch(API + '/terminal/sessions/' + termActiveId.value + '/files/download?path=' + encodeURIComponent(fmPath.value === '/' ? '/' + f.name : fmPath.value + '/' + f.name));
          if (!resp.ok) { showToast('下载失败', 'err'); return; }
          const blob = await resp.blob();
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = f.name; a.click();
          URL.revokeObjectURL(url);
        } catch(e) { showToast('下载失败: ' + e.message, 'err'); }
      }
    }
    async function fmUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      fmUploading.value = true;
      try {
        const formData = new FormData();
        formData.append('file', file);
        const resp = await fetch(API + '/terminal/sessions/' + termActiveId.value + '/files/upload?path=' + encodeURIComponent(fmPath.value), { method: 'POST', body: formData });
        if (!resp.ok) { const err = await resp.json().catch(()=>({})); showToast(err.detail || '上传失败', 'err'); }
        else { showToast('上传成功', 'ok'); await fmLoad(); }
      } catch(e) { showToast('上传失败: ' + e.message, 'err'); }
      fmUploading.value = false;
      e.target.value = '';
    }
    async function fmNewDir() {
      const name = prompt('文件夹名称:');
      if (!name) return;
      try {
        const path = fmPath.value === '/' ? '/' + name : fmPath.value + '/' + name;
        const resp = await fetch(API + '/terminal/sessions/' + termActiveId.value + '/files/mkdir', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({path}) });
        if (!resp.ok) { const e = await resp.json().catch(()=>({})); showToast(e.detail || '创建失败', 'err'); }
        else { await fmLoad(); }
      } catch(e) { showToast('创建失败: ' + e.message, 'err'); }
    }
    async function fmDelete() {
      if (!fmSelected.value) return;
      if (!confirm('确认删除 ' + fmSelected.value + ' ?')) return;
      try {
        const path = fmPath.value === '/' ? '/' + fmSelected.value : fmPath.value + '/' + fmSelected.value;
        const resp = await fetch(API + '/terminal/sessions/' + termActiveId.value + '/files/delete', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({path}) });
        if (!resp.ok) { const e = await resp.json().catch(()=>({})); showToast(e.detail || '删除失败', 'err'); }
        else { fmSelected.value = ''; await fmLoad(); showToast('已删除', 'ok'); }
      } catch(e) { showToast('删除失败: ' + e.message, 'err'); }
    }
    async function fmRename() {
      if (!fmSelected.value) return;
      const newName = prompt('新名称:', fmSelected.value);
      if (!newName || newName === fmSelected.value) return;
      try {
        const oldPath = fmPath.value === '/' ? '/' + fmSelected.value : fmPath.value + '/' + fmSelected.value;
        const newPath = fmPath.value === '/' ? '/' + newName : fmPath.value + '/' + newName;
        const resp = await fetch(API + '/terminal/sessions/' + termActiveId.value + '/files/rename', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({old_path: oldPath, new_path: newPath}) });
        if (!resp.ok) { const e = await resp.json().catch(()=>({})); showToast(e.detail || '重命名失败', 'err'); }
        else { fmSelected.value = ''; await fmLoad(); }
      } catch(e) { showToast('重命名失败: ' + e.message, 'err'); }
    }
    function fmFormatSize(bytes) {
      if (bytes < 1024) return bytes + 'B';
      if (bytes < 1048576) return (bytes/1024).toFixed(1) + 'K';
      if (bytes < 1073741824) return (bytes/1048576).toFixed(1) + 'M';
      return (bytes/1073741824).toFixed(1) + 'G';
    }

    function termSaveState() {
      sessionStorage.setItem('ops_terms', JSON.stringify(
        termTabs.value.map(t => ({id: t.id, name: t.name, serverId: t.serverId}))
      ));
      sessionStorage.setItem('ops_term_active', termActiveId.value);
    }
    async function termConnect(serverId) {
      try {
        const resp = await fetch(API + '/terminal/sessions', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({server_id: serverId, cols: 80, rows: 24})
        });
        if (!resp.ok) {
          const err = await resp.json().catch(()=>({}));
          showToast(err.detail || '连接失败', 'err');
          return;
        }
        const data = await resp.json();
        termCounter++;
        const tab = {
          id: data.session_id,
          name: data.server_name + ' (' + data.user + ')',
          serverId: serverId,
          connected: true,
          term: null,
          ws: null,
          fitAddon: null,
        };
        termTabs.value.push(tab);
        termActiveId.value = tab.id;
        currentPage.value = 'terminal';
        termSaveState();
        await nextTick();
        // Initialize xterm after DOM renders
        setTimeout(() => termInit(tab), 100);
      } catch(e) {
        showToast('终端连接失败: ' + e.message, 'err');
      }
    }
    async function termRestore() {
      const saved = sessionStorage.getItem('ops_terms');
      const savedActive = sessionStorage.getItem('ops_term_active');
      if (!saved) return;
      let tabs;
      try { tabs = JSON.parse(saved); } catch(e) { return; }
      if (!tabs || tabs.length === 0) return;
      for (const t of tabs) {
        try {
          const resp = await fetch(API + '/terminal/sessions/' + t.id + '/status');
          const status = await resp.json();
          if (status.reconnectable) {
            const tab = {
              id: t.id,
              name: t.name || (status.server_name + ' (' + status.user + ')'),
              serverId: t.serverId || status.server_id,
              connected: true,
              term: null,
              ws: null,
              fitAddon: null,
            };
            termTabs.value.push(tab);
          } else {
            // Session expired, create new one
            if (t.serverId) {
              try {
                const resp2 = await fetch(API + '/terminal/sessions', {
                  method: 'POST',
                  headers: {'Content-Type': 'application/json'},
                  body: JSON.stringify({server_id: t.serverId, cols: 80, rows: 24})
                });
                if (resp2.ok) {
                  const data = await resp2.json();
                  const tab = {
                    id: data.session_id,
                    name: data.server_name + ' (' + data.user + ')',
                    serverId: t.serverId,
                    connected: true,
                    term: null,
                    ws: null,
                    fitAddon: null,
                  };
                  termTabs.value.push(tab);
                }
              } catch(e) {}
            }
          }
        } catch(e) {}
      }
      if (termTabs.value.length > 0) {
        // Try to restore active tab, fallback to last
        const isActiveAlive = termTabs.value.some(t => t.id === savedActive);
        termActiveId.value = isActiveAlive ? savedActive : termTabs.value[termTabs.value.length-1].id;
        // Don't override currentPage - let localStorage value decide which page to show
        termSaveState();
        await nextTick();
        // Init xterm for each tab (reconnect WebSocket)
        for (const tab of termTabs.value) {
          setTimeout(() => termInit(tab), 100);
        }
      }
    }

    function termInit(tab) {
      const container = termRefs[tab.id];
      if (!container || tab.term) return;
      const term = new Terminal({
        cursorBlink: true,
        fontSize: 14,
        fontFamily: 'Menlo, Monaco, Consolas, "Courier New", monospace',
        theme: {background:'#0d1117',foreground:'#e6edf3',cursor:'#2dd4bf',selectionBackground:'rgba(45,212,191,.3)'},
        scrollback: 5000,
      });
      const fitAddon = new FitAddon.FitAddon();
      const webLinksAddon = new WebLinksAddon.WebLinksAddon();
      term.loadAddon(fitAddon);
      term.loadAddon(webLinksAddon);
      term.open(container);
      try { fitAddon.fit(); } catch(e) {}
      tab.term = term;
      tab.fitAddon = fitAddon;

      // Open WebSocket
      const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = wsProto + '//' + location.host + '/ws/terminal/' + tab.id;
      const ws = new WebSocket(wsUrl);
      tab.ws = ws;

      ws.onopen = () => {
        tab.connected = true;
        // Send initial resize
        const dims = fitAddon.proposeDimensions();
        if (dims) {
          ws.send(JSON.stringify({type:'resize', cols:dims.cols, rows:dims.rows}));
        }
      };

      ws.onmessage = (evt) => {
        term.write(evt.data);
      };

      ws.onclose = () => {
        tab.connected = false;
        if (tab.term) {
          tab.term.write('\r\n\x1b[31m--- 连接已断开 ---\x1b[0m\r\n');
        }
      };

      ws.onerror = () => {
        tab.connected = false;
        showToast('WebSocket 连接错误', 'err');
      };

      // Send user input
      term.onData((data) => {
        if (ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify({type:'input', data}));
        }
      });

      // Handle resize
      term.onResize(({cols, rows}) => {
        if (ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify({type:'resize', cols, rows}));
        }
      });

      // Window resize handler
      const resizeHandler = () => {
        if (tab.term && tab.fitAddon) {
          try { tab.fitAddon.fit(); } catch(e) {}
        }
      };
      window.addEventListener('resize', resizeHandler);
      tab._resizeHandler = resizeHandler;
    }

    function termClose(tabId) {
      const idx = termTabs.value.findIndex(t => t.id === tabId);
      if (idx < 0) return;
      const tab = termTabs.value[idx];
      if (tab.ws) { try { tab.ws.close(); } catch(e) {} }
      if (tab.term) { try { tab.term.dispose(); } catch(e) {} }
      if (tab._resizeHandler) { window.removeEventListener('resize', tab._resizeHandler); }
      termTabs.value.splice(idx, 1);
      delete termRefs[tabId];
      if (termActiveId.value === tabId) {
        termActiveId.value = termTabs.value.length > 0 ? termTabs.value[termTabs.value.length-1].id : '';
      }
      termSaveState();
    }

    const showTermPicker = ref(false);
    function termQuickConnect() {
      if (servers.value.length === 0) {
        showToast('暂无可用服务器', 'warn');
        return;
      }
      if (servers.value.length === 1) {
        termConnect(servers.value[0].id);
        return;
      }
      showTermPicker.value = !showTermPicker.value;
    }
    function termPickServer(srv) {
      showTermPicker.value = false;
      termConnect(srv.id);
      termSaveState();
    }
    function termPickOutside(e) {
      if (showTermPicker.value && !e.target.closest('.term-picker-wrap')) {
        showTermPicker.value = false;
      }
    }

    // Auto-resize active terminal when switching tabs
    watch(termActiveId, (newId) => {
      if (newId) {
        const tab = termTabs.value.find(t => t.id === newId);
        if (tab && tab.fitAddon) {
          setTimeout(() => { try { tab.fitAddon.fit(); } catch(e) {} }, 50);
        }
      }
    });

    // Refit terminals when switching back to terminal page
    watch(currentPage, async (newPage) => {
      if (newPage === 'terminal') {
        await nextTick();
        // Double rAF ensures browser has completed layout after v-show reveals DOM
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            termTabs.value.forEach(t => {
              if (t.fitAddon) {
                try { t.fitAddon.fit(); } catch(e) {}
              }
              // Force xterm to refresh its canvas
              if (t.term) {
                try { t.term.refresh(0, t.term.rows - 1); } catch(e) {}
              }
            });
          });
        });
      }
    });



    return {
      currentPage, darkMode, searchQuery, clock, collapsed,
      groupConfig, autoServices,
      mergedGroups, filteredGroups, stats, effectiveStatus,
      navServerId, navServerTabs,
      selectedGroupIds, showAllGroups, toggleGroupFilter, clearGroupFilter,
      showGroupModal, newGroupName, newGroupId, newGroupColor,
      addGroup, deleteGroup, startEditGroup, cancelEditGroup, saveEditGroup, editingGroup, editGroupName, editGroupColor, editGroupOrder, moveServiceToGroup,
      groupManageServerId, applyDefaultGroups,

      copyText, iconMap, openService,
      termTabs, termActiveId, termRefs, termConnect, termClose, termQuickConnect,
      showTermPicker, termPickServer, termPickOutside, termSaveState, termRestore,
      fmShow, fmPath, fmFiles, fmLoading, fmSelected, fmUploading, fmPathSegments, fmPathPrefix,
      fmToggle, fmLoad, fmCd, fmRefresh, fmSelect, fmOpen, fmUpload, fmNewDir, fmDelete, fmRename, fmFormatSize, termSaveState, termRestore,
      servers, currentServerId, monitorData, containers, isCurrentServerOffline,
      selectedMetric, historyHours, historyData, chartBox, metricCards,
      getMetric, loadMonitor, loadHistory, formatBytes, formatUptime, formatContainerPorts,

      scanningServerId,
      triggerScan,
      deployAgent, checkAgentStatus,
      serverServices, getSvcCount, toggleSvcHidden, openEditSvc,
      showEditSvcModal, editSvcForm, saveEditSvc,
      resServerId, switchResServer,
      showAddServerModal, newServer, sshTestResult,
      addServer, testSsh, deleteServer,
      showEditServerModal, editServerForm, editSshTestResult,
      openEditServer, saveEditServer, testEditSsh,
    };
  },

  template: `
<div class="app" :class="{light: !darkMode}">
  <!-- Sidebar -->
  <aside class="sidebar" :class="{collapsed}">
    <div class="sidebar-logo">
      <div class="logo-icon">O</div>
      <div class="logo-text" v-show="!collapsed">OpsCenter<small>运维工作台 v3.12.1</small></div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-title">主导航</div>
      <div class="nav-item" :class="{active:currentPage==='nav'}" @click="currentPage='nav'">
        <svg class="nav-icon"><use href="#fa-server"/></svg><span>服务导航</span>
      </div>
      <div class="nav-item" :class="{active:currentPage==='monitor'}" @click="currentPage='monitor'">
        <svg class="nav-icon"><use href="#fa-gauge"/></svg><span>监控中心</span>
      </div>

      <div class="nav-item" :class="{active:currentPage==='resources'}" @click="currentPage='resources'">
        <svg class="nav-icon"><use href="#fa-layer-group"/></svg><span>资源管理</span>
      </div>
      <div class="nav-item" :class="{active:currentPage==='terminal'}" @click="currentPage='terminal'">
        <svg class="nav-icon"><use href="#fa-terminal"/></svg><span>终端</span>
      </div>

    </nav>
    <div class="sidebar-footer">
      <span class="online-dot"></span><span class="sidebar-footer-text">{{servers.length}} 服务器 · {{stats.total}} 服务</span>
    </div>
  </aside>

  <!-- Main -->
  <div class="main" :class="{expanded:collapsed}">
    <header class="topbar">
      <div class="topbar-left">
        <button class="icon-btn" @click="collapsed=!collapsed" :title="collapsed?'展开':'折叠'">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3h12v1.5H2zm0 4.25h12v1.5H2zm0 4.25h8v1.5H2z"/></svg>
        </button>
        <h2>{{currentPage==='nav'?'服务导航':currentPage==='monitor'?'监控中心':currentPage==='resources'?'资源管理':'终端'}}</h2>
      </div>
      <div class="topbar-right">
        <div class="search-box" v-if="currentPage==='nav'">
          <svg><use href="#fa-globe" style="width:14px;height:14px"/></svg>
          <input v-model="searchQuery" placeholder="搜索服务... (Ctrl+K)">
        </div>
        <span class="clock">{{clock}}</span>
        <button class="icon-btn" @click="darkMode=!darkMode" :title="darkMode?'亮色模式':'暗色模式'">{{darkMode?'☀':'🌙'}}</button>
      </div>
    </header>

    <!-- ===== NAV PAGE ===== -->
    <div class="content" v-if="currentPage==='nav'">
      <!-- Stat Cards (top priority) -->
      <div class="stat-row">
        <div class="stat-card teal"><div class="num">{{stats.total}}</div><div class="label">服务总数</div></div>
        <div class="stat-card green"><div class="num">{{stats.online}}</div><div class="label">在线</div></div>
        <div class="stat-card red"><div class="num">{{stats.offline}}</div><div class="label">离线</div></div>
        <div class="stat-card orange"><div class="num">{{stats.srvOff}}</div><div class="label">服务器离线</div></div>
      </div>

      <!-- Group Filter Chips (primary filter) -->
      <div class="group-filter-bar">
        <div class="group-chip" :class="{active: showAllGroups}" @click="clearGroupFilter()">
          全部 <span class="chip-count">{{autoServices.length}}</span>
        </div>
        <div v-for="g in mergedGroups" :key="g.id"
             class="group-chip"
             :class="{active: !showAllGroups && selectedGroupIds.has(g.id)}"
             :style="!showAllGroups && selectedGroupIds.has(g.id) ? {background:g.color, borderColor:g.color} : {}"
             @click="toggleGroupFilter(g.id)">
          <span class="chip-dot" :style="{background:g.color}" v-if="!(!showAllGroups && selectedGroupIds.has(g.id))"></span>
          {{g.name}} <span class="chip-count">{{g.services.length}}</span>
        </div>
      </div>

      <!-- Server Filter (auxiliary) -->
      <div class="server-filter-label">服务器筛选</div>
      <div class="server-tabs">
        <div class="server-tab" :class="{active: !navServerId}" @click="navServerId=''">
          全部
          <span class="st-count">{{autoServices.length}}</span>
        </div>
        <div class="server-tab" v-for="srv in navServerTabs" :key="srv.id"
             :class="{active: navServerId===srv.id}" @click="navServerId=srv.id">
          <span class="st-dot" :class="srv.status==='online'?'online':'offline'"></span>
          {{srv.name}}
          <span class="st-count">{{srv.serviceCount}}</span>
        </div>
      </div>

      <div class="group-section" v-for="g in filteredGroups" :key="g.id">
        <div class="group-header">
          <span class="group-dot" :style="{background:g.color}"></span>
          <span class="group-name">{{g.name}}</span>
          <span class="group-count">{{g.services.length}} 个服务</span>
          <span v-if="g.services.filter(s=>effectiveStatus(s)==='online').length>0" style="font-size:11px;color:var(--green);margin-left:4px">
            {{g.services.filter(s=>effectiveStatus(s)==='online').length}} 在线
          </span>
        </div>
        <div class="svc-grid">
          <div class="svc-card" v-for="s in g.services" :key="s.serviceKey" @click="openService(s.fullUrl)">
            <div class="svc-card-top">
              <div class="svc-name">
                <span class="status-dot" :class="effectiveStatus(s)"></span>
                {{s.name}}
              </div>
              <span class="svc-badge"
                :class="effectiveStatus(s)==='server_offline' ? 'srv-offline' : 'auto'">
                {{effectiveStatus(s)==='server_offline' ? '服务器离线' : '自动检测'}}
              </span>
            </div>
            <div class="svc-desc">{{s.desc || s.description || ''}}</div>
            <div class="svc-server-info" v-if="!navServerId">
              <svg width="12" height="12"><use href="#fa-server"/></svg>
              {{s.serverName}}
              <span v-if="s.containerName" style="margin-left:6px">| {{s.containerName}}</span>
            </div>
            <div class="svc-server-info" v-else-if="s.containerName">
              {{s.containerName}}
            </div>
            <div class="svc-url" v-if="s.fullUrl">
              <a :href="s.fullUrl" target="_blank" rel="noopener">{{s.fullUrl}}</a>
              <span v-if="s.url_overridden" style="margin-left:4px;color:#ea580c;font-size:12px;cursor:help;" title="此地址已被手动修改，扫描时不会被覆盖">✎</span>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- ===== MONITOR PAGE ===== -->
    <div class="content" v-if="currentPage==='monitor'">
      <!-- Server Header -->
      <div class="mon-header">
        <div class="mon-header-left">
          <select v-model="currentServerId"><option v-for="s in servers" :key="s.id" :value="s.id">{{s.name}}</option></select>
          <div class="mon-status" v-if="!isCurrentServerOffline"><span class="dot"></span>在线</div>
          <div class="mon-status offline" v-else><span class="dot" style="background:var(--red);box-shadow:0 0 6px var(--red)"></span>离线</div>
          <button class="btn-sm" @click="loadMonitor">刷新</button>
        </div>
        <div class="mon-header-right" v-if="!isCurrentServerOffline">
          <div class="mon-tag"><span class="tag-label">⏱</span><span class="tag-val">{{formatUptime(getMetric('uptime'))}}</span></div>
          <div class="mon-tag"><span class="tag-label">🖥</span><span class="tag-val">{{getMetric('cpu_count') || '-'}} 核</span></div>
          <div class="mon-tag"><span class="tag-label">💾</span><span class="tag-val">{{formatBytes(getMetric('memory_used'))}} / {{formatBytes(getMetric('memory_total'))}}</span></div>
          <div class="mon-tag"><span class="tag-label">💿</span><span class="tag-val">{{formatBytes(getMetric('disk_used'))}} / {{formatBytes(getMetric('disk_total'))}}</span></div>
          <div class="mon-tag"><span class="tag-label">📦</span><span class="tag-val">{{getMetric('container_running')||0}} 运行 / {{getMetric('container_stopped')||0}} 停止</span></div>
        </div>
      </div>

      <!-- Offline State -->
      <div v-if="isCurrentServerOffline" class="mon-offline">
        <div class="offline-icon"><svg viewBox="0 0 48 48" width="48" height="48"><circle cx="24" cy="24" r="22" fill="none" stroke="var(--red)" stroke-width="2" opacity="0.5"/><line x1="16" y1="16" x2="32" y2="32" stroke="var(--red)" stroke-width="2.5" stroke-linecap="round"/><line x1="32" y1="16" x2="16" y2="32" stroke="var(--red)" stroke-width="2.5" stroke-linecap="round"/></svg></div>
        <div class="offline-text">服务器离线</div>
        <div class="offline-sub">无法获取监控数据，请检查服务器连接状态</div>
      </div>
      <!-- Online Content -->
      <template v-if="!isCurrentServerOffline">
      <!-- Core Metrics (CPU / Memory / Disk) -->
      <div class="mon-metrics">
        <div class="mon-metrics-row primary">
          <div v-for="mc in metricCards.filter(c=>c.key==='cpu'||c.key==='memory'||c.key==='disk')" :key="mc.key" class="metric-card" :class="{active:selectedMetric===mc.key}" @click="selectedMetric=mc.key;loadHistory()">
            <div class="mc-top">
              <span class="mc-icon">{{mc.icon}}</span>
              <span class="mc-label">{{mc.label}}</span>
            </div>
            <div class="mc-value" :style="{color:mc.value>90?'var(--red)':mc.value>80?'var(--orange)':mc.color}">{{mc.display}}</div>
            <div class="mc-bar"><div class="mc-bar-fill" :style="{width:Math.min(mc.value,100)+'%',background:mc.value>90?'var(--red)':mc.value>80?'var(--orange)':mc.color}"></div></div>
            <div class="mc-detail">{{mc.detail}}</div>
          </div>
        </div>
        <!-- Secondary Metrics (Network / Load / IO) -->
        <div class="mon-metrics-row secondary">
          <div v-for="mc in metricCards.filter(c=>c.key!=='cpu'&&c.key!=='memory'&&c.key!=='disk')" :key="mc.key" class="metric-card" :class="{active:selectedMetric===mc.key}" @click="selectedMetric=mc.key;loadHistory()">
            <div class="mc-top">
              <span class="mc-icon">{{mc.icon}}</span>
              <span class="mc-label">{{mc.label}}</span>
            </div>
            <div class="mc-value" :style="{color:mc.color}">{{mc.display}}</div>
            <div class="mc-detail">{{mc.detail}}</div>
          </div>
        </div>
      </div>

      <!-- History Chart -->
      <div class="chart-section">
        <div class="chart-header">
          <span class="ch-title">历史趋势</span>
          <div class="chart-metric-tabs">
            <button v-for="mt in [{k:'cpu',l:'CPU'},{k:'memory',l:'内存'},{k:'disk',l:'磁盘'},{k:'net_rx',l:'网络入'},{k:'net_tx',l:'网络出'},{k:'load1',l:'负载'},{k:'disk_read',l:'磁盘读'},{k:'disk_write',l:'磁盘写'}]" :key="mt.k"
              :class="{active:selectedMetric===mt.k}" @click="selectedMetric=mt.k;loadHistory()">{{mt.l}}</button>
          </div>
          <div class="chart-time-tabs">
            <button v-for="tr in [{h:1,l:'1h'},{h:3,l:'3h'},{h:6,l:'6h'},{h:12,l:'12h'},{h:24,l:'24h'},{h:72,l:'3天'},{h:168,l:'7天'}]" :key="tr.h"
              :class="{active:historyHours===tr.h}" @click="historyHours=tr.h;loadHistory()">{{tr.l}}</button>
          </div>
        </div>
        <div ref="chartBox" class="chart-container"></div>
      </div>

      <!-- Containers Table -->
      <div class="container-table">
        <table>
          <thead><tr><th>名称</th><th>镜像</th><th>状态</th><th>端口</th></tr></thead>
          <tbody><tr v-for="c in containers" :key="c.name||c.id">
            <td style="font-weight:500">{{c.name||c.Names}}</td>
            <td style="font-size:11px;color:var(--text2)">{{c.image||c.Image}}</td>
            <td><span :class="{'running-dot':(c.status||c.Status||'').includes('running')}">{{c.status||c.Status}}</span></td>
            <td style="font-size:11px;color:var(--text2);font-family:Consolas,monospace">{{formatContainerPorts(c.ports||c.Ports)}}</td>
          </tr></tbody>
        </table>
      </div>
      </template>
    </div>



    <!-- ===== RESOURCES PAGE ===== -->
    <!-- ===== TERMINAL PAGE ===== -->
    <div class="content" v-show="currentPage==='terminal'" style="padding:0">
      <div class="term-page" @click="termPickOutside">
        <div class="term-tabs">
          <div class="term-tab" v-for="t in termTabs" :key="t.id" :class="{active:termActiveId===t.id}" @click="termActiveId=t.id">
            <span class="tab-dot" :class="t.connected?'on':'off'"></span>
            <span class="tab-name">{{t.name}}</span>
            <span class="tab-close" @click.stop="termClose(t.id)">x</span>
          </div>
          <div class="term-picker-wrap" style="position:relative">
            <div class="term-tab-add" @click="termQuickConnect" title="新建终端">+</div>
            <div class="term-picker" v-if="showTermPicker" @click.stop>
              <div class="term-picker-head">选择服务器</div>
              <div class="term-picker-item" v-for="srv in servers" :key="srv.id" @click="termPickServer(srv)">
                <span class="term-picker-dot" :class="srv.status==='online'?'on':'off'"></span>
                <span class="term-picker-name">{{srv.name}}</span>
                <span class="term-picker-addr">{{srv.host}}:{{srv.port}}</span>
              </div>
            </div>
          </div>
          <div class="fm-btn" @click="fmToggle" title="文件管理" v-if="termTabs.length>0">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 3a1 1 0 011-1h3.586a1 1 0 01.707.293l1.5 1.5H13.5a1 1 0 011 1V5h-13V3z" opacity=".6"/><path d="M2.5 6h11a1 1 0 011 1v5a1 1 0 01-1 1h-11a1 1 0 01-1-1V7a1 1 0 011-1z"/></svg>
          </div>
        </div>
        <div class="term-body" v-for="t in termTabs" :key="t.id" v-show="termActiveId===t.id" :ref="el=>{if(el)termRefs[t.id]=el}"></div>
        <!-- File Manager Drawer -->
        <div class="fm-drawer" v-if="fmShow">
          <div class="fm-header">
            <div class="fm-title">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 3a1 1 0 011-1h3.586a1 1 0 01.707.293l1.5 1.5H13.5a1 1 0 011 1V5h-13V3z" opacity=".6"/><path d="M2.5 6h11a1 1 0 011 1v5a1 1 0 01-1 1h-11a1 1 0 01-1-1V7a1 1 0 011-1z"/></svg>
              文件管理
            </div>
            <span class="fm-close" @click="fmShow=false">x</span>
          </div>
          <div class="fm-path-bar">
            <span class="fm-path-crumb" @click="fmCd('/')">/</span>
            <template v-for="(seg, i) in fmPathSegments" :key="i">
              <span class="fm-path-sep">/</span>
              <span class="fm-path-crumb" @click="fmCd(fmPathPrefix(i))">{{seg}}</span>
            </template>
          </div>
          <div class="fm-toolbar">
            <span class="fm-tbtn" @click="fmCd('..')">↑ 上级</span>
            <span class="fm-tbtn" @click="fmRefresh">↻ 刷新</span>
            <span class="fm-tbtn" @click="fmNewDir">+ 文件夹</span>
            <span class="fm-tbtn danger" v-if="fmSelected" @click="fmDelete">删除</span>
            <span class="fm-tbtn" v-if="fmSelected" @click="fmRename">重命名</span>
          </div>
          <div class="fm-list" v-if="fmLoading">
            <div class="fm-loading">加载中...</div>
          </div>
          <div class="fm-list" v-else-if="fmFiles.length===0">
            <div class="fm-empty">空目录</div>
          </div>
          <div class="fm-list" v-else>
            <div class="fm-item" v-for="f in fmFiles" :key="f.name"
                 :class="{selected:fmSelected===f.name}"
                 @click="fmSelect(f)" @dblclick="fmOpen(f)">
              <span class="fm-icon">{{f.is_dir?'📁':'📄'}}</span>
              <span class="fm-name">{{f.name}}</span>
              <span class="fm-size" v-if="!f.is_dir">{{fmFormatSize(f.size)}}</span>
            </div>
          </div>
          <div class="fm-upload-bar">
            <label class="fm-upload-label">⬆ 上传文件
              <input type="file" style="display:none" @change="fmUpload($event)">
            </label>
            <span class="fm-upload-status" v-if="fmUploading">上传中...</span>
          </div>
        </div>
        <div class="term-empty" v-if="termTabs.length===0">
          <svg><use href="#fa-terminal"/></svg>
          <p>点击服务器「终端」按钮或按 + 连接</p>
        </div>
      </div>
    </div>

    <div class="content" v-if="currentPage==='resources'">
      <!-- Header with add button -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
        <div style="display:flex;gap:12px;align-items:baseline">
          <span style="font-size:14px;font-weight:600;color:var(--text1)">{{servers.length}} 台服务器</span>
          <span style="font-size:12px;color:var(--text2)">{{servers.filter(s=>s.status==='online').length}} 在线</span>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn-sm" @click="showGroupModal=true" style="font-size:13px;padding:6px 16px">
            管理分组
          </button>
          <button class="btn-sm primary" @click="showAddServerModal=true" style="font-size:13px;padding:6px 16px">
            + 添加服务器
          </button>
        </div>
      </div>

      <!-- Server Tab Bar -->
      <div class="res-server-tabs">
        <div class="res-server-tab" v-for="srv in servers" :key="srv.id"
             :class="{active: resServerId===srv.id}" @click="switchResServer(srv.id)">
          <span class="rst-dot" :class="srv.status==='online'?'online':'offline'"></span>
          <div class="rst-info">
            <span class="rst-name">{{srv.name}}</span>
            <span class="rst-detail">{{srv.host}}:{{srv.ssh_port||22}} · {{getSvcCount(srv.id).visible}}/{{getSvcCount(srv.id).total}} 服务</span>
          </div>
        </div>
      </div>

      <!-- Selected Server Detail -->
      <template v-for="srv in servers" :key="srv.id">
      <div class="server-card" v-if="resServerId===srv.id">
          <!-- Header -->
          <div class="sc-header">
            <div class="sc-title">
              <span class="status-dot" :class="srv.status==='online'?'online':'offline'" style="width:10px;height:10px"></span>
              <h4>{{srv.name}}</h4>
              <span v-if="srv.is_local" class="sc-badge online">本机</span>
              <span v-if="srv.agent_status==='running' && srv.agent_version" style="font-size:11px;color:#64748b;margin-left:4px;">v{{srv.agent_version}}</span>
              <span v-if="srv.agent_status && !srv.is_local" class="agent-tag" :class="srv.agent_status">
                {{srv.agent_status === 'running' ? 'Agent运行中' : srv.agent_status === 'not_deployed' ? '未部署Agent' : srv.agent_status === 'deploying' ? '部署中...' : srv.agent_status === 'stopped' ? 'Agent已停止' : 'Agent异常'}}
              </span>
            </div>
            <span class="sc-badge" :class="srv.status==='online'?'online':'offline'">{{srv.status==='online'?'在线':'离线'}}</span>
          </div>
          <!-- Body -->
          <div class="sc-body">
            <!-- Info grid -->
            <div class="sc-info">
              <div class="sc-info-item">
                <span class="sc-info-label">主机</span>
                <span class="sc-info-val" style="font-family:Consolas,monospace">{{srv.host}}:{{srv.ssh_port || 22}}</span>
              </div>
              <div class="sc-info-item">
                <span class="sc-info-label">用户</span>
                <span class="sc-info-val">{{srv.ssh_user || '-'}}</span>
              </div>
              <div class="sc-info-item">
                <span class="sc-info-label">凭证</span>
                <span class="sc-badge" :class="srv.has_credentials?'ok':'warn'">{{srv.has_credentials?'已配置':'未配置'}}</span>
              </div>
              <div class="sc-info-item">
                <span class="sc-info-label">服务</span>
                <span class="sc-info-val">{{getSvcCount(srv.id).visible}} 可见<template v-if="getSvcCount(srv.id).hidden"> / {{getSvcCount(srv.id).hidden}} 隐藏</template></span>
              </div>
            </div>
            <!-- Agent info -->
            <div v-if="srv.agent_status==='running' || srv.last_seen" style="font-size:11px;color:var(--text2);margin-bottom:12px;display:flex;gap:12px;flex-wrap:wrap">
              <span v-if="srv.agent_status==='running'" style="color:var(--green)">Agent :{{srv.agent_port||19100}} v{{srv.agent_version||'1.0'}}</span>
              <span v-if="srv.last_seen">最后在线: {{new Date(srv.last_seen+'Z').toLocaleString('zh-CN')}}</span>
            </div>
            <!-- Action buttons -->
            <div class="sc-btn-row">
              <button class="btn-sm primary" @click="currentServerId=srv.id;currentPage='monitor'">监控</button>
              <button class="btn-sm" @click="termConnect(srv.id)" style="color:var(--accent)">终端</button>
              <button class="btn-sm" :disabled="scanningServerId===srv.id" @click="triggerScan(srv.id)">{{scanningServerId===srv.id ? "扫描中..." : "扫描"}}</button>
              <button class="btn-deploy-agent" v-if="!srv.is_local && srv.agent_status!=='running' && srv.agent_status!=='deploying'" @click="deployAgent(srv.id)">部署Agent</button>
              <button class="btn-deploy-agent" v-if="srv.agent_status==='running'" @click="deployAgent(srv.id)">{{ srv.is_local ? '升级Agent' : '升级Agent' }}</button>
              <button class="btn-sm" v-if="srv.agent_status==='running'" @click="checkAgentStatus(srv.id)" style="font-size:11px;color:var(--green)">检查Agent</button>
              <button class="btn-sm" @click="openEditServer(srv)" style="color:var(--accent2)">编辑</button>
              <div style="flex:1"></div>
              <button class="btn-sm danger" v-if="!srv.is_local" @click="deleteServer(srv.id)">删除</button>
            </div>
            <!-- Service list -->
            <div class="svc-list" v-if="(serverServices[srv.id]||[]).length">
              <div class="svc-list-header">
                <span class="svc-list-title">服务列表</span>
              </div>
              <div class="svc-item" v-for="s in serverServices[srv.id]" :key="s.id" :class="{'hidden-svc': s.hidden}">
                <span class="svc-name" :title="s.description || s.name">{{s.name}}</span>
                <span class="svc-cat" v-if="s.category">{{s.category}}</span>
                <div class="svc-creds">
                  <template v-if="s.account || s.password">
                    <span class="svc-cred" v-if="s.account">
                      <svg class="cred-icon"><use href="#fa-user"/></svg>
                      <span class="cred-val" :title="s.account">{{s.account}}</span>
                      <button class="cred-copy" @click="copyText(s.account)" title="复制账号">复制</button>
                    </span>
                    <span class="svc-cred" v-if="s.password">
                      <svg class="cred-icon"><use href="#fa-key"/></svg>
                      <span class="cred-val">****</span>
                      <button class="cred-copy" @click="copyText(s.password)" title="复制密码">复制</button>
                    </span>
                  </template>
                  <template v-else>
                    <span class="svc-cred-empty">未配置凭证</span>
                  </template>
                </div>
                <div class="svc-actions">
                  <select class="svc-move-select" :value="(groupConfig.servers[s.server_id]?.serviceGroupMap || {})['auto:'+s.server_id+':'+s.id] || ''" @change="moveServiceToGroup('auto:'+s.server_id+':'+s.id, $event.target.value)">
                    <option value="">分组</option>
                    <option v-for="og in (groupConfig.servers[s.server_id]?.groups || groupConfig.defaultGroups || []).filter(g=>g.id!=='ungrouped')" :key="og.id" :value="og.id">{{og.name}}</option>
                    <option value="ungrouped">未分组</option>
                  </select>
                  <button class="svc-tag" :class="s.hidden ? 'hid' : 'vis'" @click="toggleSvcHidden(s)" :title="s.hidden ? '点击显示' : '点击隐藏'">
                    {{s.hidden ? '已隐藏' : '可见'}}
                  </button>
                  <button class="svc-edit-btn" @click="openEditSvc(s)" title="编辑">&#9998;</button>
                </div>
              </div>
            </div>
            <div v-else style="font-size:12px;color:var(--text2);text-align:center;padding:20px 0">暂无服务数据，点击"扫描"发现服务</div>
          </div>
        </div>
      </template>
    </div>

    <!-- ===== Group Management Modal (per-server) ===== -->
    <div class="modal-overlay" v-if="showGroupModal" @click.self="showGroupModal=false">
      <div class="modal">
        <h3>分组管理</h3>

        <!-- Server Selector -->
        <div class="modal-row" style="margin-bottom:16px;align-items:center">
          <label>服务器</label>
          <select v-model="groupManageServerId" style="flex:1;padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--card);color:var(--text1);font-size:13px">
            <option value="">选择服务器</option>
            <option v-for="srv in servers" :key="srv.id" :value="srv.id">{{srv.name}}</option>
          </select>
          <button class="btn-sm" @click="applyDefaultGroups(groupManageServerId)" style="white-space:nowrap" title="将默认分组配置应用到此服务器">应用默认分组</button>
        </div>

        <!-- Per-server group list -->
        <template v-if="groupManageServerId">
          <div v-for="g in (groupConfig.servers?.[groupManageServerId]?.groups || groupConfig.groups)" :key="g.id" class="group-list-item" style="flex-wrap:wrap">
            <template v-if="editingGroup!==g.id">
              <span class="g-dot" :style="{background:g.color}"></span>
              <span class="g-name">{{g.name}}</span>
              <span class="g-order">排序: {{g.order}}</span>
              <div class="g-btns">
                <button class="btn-sm" @click="startEditGroup(g)">编辑</button>
                <button class="btn-sm danger" @click="deleteGroup(g.id)" v-if="g.id!=='ungrouped'">删除</button>
              </div>
            </template>
            <template v-else>
              <div style="width:100%;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <input v-model="editGroupName" placeholder="分组名称" style="width:120px;padding:4px 8px;border:1px solid var(--border);border-radius:6px;font-size:13px">
                <input type="color" v-model="editGroupColor" style="width:32px;height:28px;border:none;cursor:pointer">
                <input type="number" v-model.number="editGroupOrder" placeholder="排序" style="width:70px;padding:4px 8px;border:1px solid var(--border);border-radius:6px;font-size:13px">
                <button class="btn-sm primary" @click="saveEditGroup(g)">保存</button>
                <button class="btn-sm" @click="cancelEditGroup">取消</button>
              </div>
            </template>
          </div>
          <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
            <div style="font-size:13px;font-weight:500;margin-bottom:8px">新增分组</div>
            <div class="modal-row"><label>ID</label><input v-model="newGroupId" placeholder="英文标识如 cicd"></div>
            <div class="modal-row"><label>名称</label><input v-model="newGroupName" placeholder="如: 代码与CI/CD"></div>
            <div class="modal-row"><label>颜色</label><input type="color" v-model="newGroupColor"></div>
            <div style="text-align:right"><button class="btn-sm primary" @click="addGroup">添加</button></div>
          </div>
        </template>
        <div v-else style="text-align:center;padding:30px 0;color:var(--text2);font-size:13px">
          请先选择一台服务器
        </div>
        <div class="modal-footer">
          <button class="btn-sm" @click="showGroupModal=false">关闭</button>
        </div>
      </div>
    </div>

    <!-- ===== Edit Service Modal ===== -->
    <div class="modal-overlay" v-if="showEditSvcModal" @click.self="showEditSvcModal=false">
      <div class="modal" style="min-width:420px">
        <h3>编辑服务</h3>
        <div class="modal-row">
          <label>名称</label>
          <input v-model="editSvcForm.name" style="flex:1">
        </div>
        <div class="modal-row">
          <label>访问地址</label>
          <div style="flex:1;display:flex;flex-direction:column">
            <input v-model="editSvcForm.url" placeholder="http://host:port/path" style="width:100%">
            <div v-if="editSvcForm.url_overridden" style="margin-top:4px;display:flex;align-items:center;gap:8px;">
              <span style="font-size:12px;color:#ea580c;background:#fff7ed;padding:2px 8px;border-radius:4px;">已手动修改</span>
              <button @click="resetSvcUrl(editSvcForm)" style="font-size:12px;color:#2563eb;background:none;border:1px solid #2563eb;padding:2px 8px;border-radius:4px;cursor:pointer;">恢复自动地址</button>
            </div>
          </div>
        </div>
        <div class="modal-row">
          <label>描述</label>
          <input v-model="editSvcForm.description" placeholder="服务描述" style="flex:1">
        </div>
        <div style="margin:12px 0 8px;padding-top:10px;border-top:1px solid var(--border)">
          <div style="font-size:12px;font-weight:500;color:var(--text2);margin-bottom:8px">登录凭证（可选）</div>
          <div class="modal-row">
            <label>账号</label>
            <input v-model="editSvcForm.account" placeholder="登录账号，留空清除" style="flex:1">
          </div>
          <div class="modal-row">
            <label>密码</label>
            <input v-model="editSvcForm.password" type="password" placeholder="登录密码，留空清除" style="flex:1">
          </div>
        </div>
        <div style="margin:12px 0;display:flex;align-items:center;gap:8px">
          <label style="font-size:13px;color:var(--text1);cursor:pointer;display:flex;align-items:center;gap:6px">
            <input type="checkbox" v-model="editSvcForm.hidden"> 在服务导航中隐藏
          </label>
        </div>
        <div class="modal-footer">
          <button class="btn-sm" @click="showEditSvcModal=false">取消</button>
          <button class="btn-sm primary" @click="saveEditSvc">保存</button>
        </div>
      </div>
    </div>

    <!-- ===== Edit Server Modal ===== -->
    <div class="modal-overlay" v-if="showEditServerModal" @click.self="showEditServerModal=false">
      <div class="modal" style="min-width:520px">
        <h3>编辑服务器</h3>

        <div class="modal-row">
          <label>服务器名称</label>
          <input v-model="editServerForm.name" placeholder="例如: 生产环境Web" style="flex:1">
        </div>
        <div class="modal-row">
          <label>主机地址</label>
          <input v-model="editServerForm.host" placeholder="IP 或域名" style="flex:1">
        </div>
        <div class="modal-row">
          <label>SSH端口</label>
          <input v-model.number="editServerForm.ssh_port" type="number" placeholder="22" style="width:100px">
        </div>
        <div class="modal-row">
          <label>SSH用户名</label>
          <input v-model="editServerForm.ssh_user" placeholder="root" style="flex:1">
        </div>

        <!-- Auth type selection -->
        <div style="margin:12px 0 8px;font-size:13px;color:var(--text2)">登录方式</div>
        <div style="display:flex;gap:12px;margin-bottom:12px">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:var(--text1)">
            <input type="radio" value="password" v-model="editServerForm.auth_type"> 密码登录
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:var(--text1)">
            <input type="radio" value="key" v-model="editServerForm.auth_type"> 密钥登录
          </label>
        </div>

        <!-- Password field -->
        <div class="modal-row" v-if="editServerForm.auth_type==='password'">
          <label>新密码</label>
          <input v-model="editServerForm.ssh_password" type="password" placeholder="留空则不修改密码" style="flex:1">
        </div>

        <!-- SSH Key field -->
        <div v-if="editServerForm.auth_type==='key'" style="margin-bottom:10px">
          <label style="font-size:13px;color:var(--text2);display:block;margin-bottom:6px">新SSH私钥</label>
          <textarea v-model="editServerForm.ssh_key" placeholder="粘贴新私钥内容（留空则不修改）"
            style="width:100%;height:120px;padding:8px;border-radius:6px;border:1px solid var(--border);background:var(--card);color:var(--text1);font-size:12px;font-family:Consolas,monospace;resize:vertical"></textarea>
        </div>

        <!-- Test result -->
        <div v-if="editSshTestResult.message" style="margin:10px 0;padding:8px 12px;border-radius:8px;font-size:13px"
          :style="{
            background: editSshTestResult.success ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.1)',
            color: editSshTestResult.success ? 'var(--green)' : 'var(--red)',
            border: '1px solid ' + (editSshTestResult.success ? 'rgba(34,197,94,.3)' : 'rgba(239,68,68,.3)')
          }">
          {{ editSshTestResult.success ? '✓' : '✗' }} {{ editSshTestResult.message }}
        </div>

        <div class="modal-footer">
          <button class="btn-sm" @click="testEditSsh" :disabled="editSshTestResult.testing" style="margin-right:auto">
            {{ editSshTestResult.testing ? '测试中...' : '测试连接' }}
          </button>
          <button class="btn-sm" @click="showEditServerModal=false">取消</button>
          <button class="btn-sm primary" @click="saveEditServer">保存</button>
        </div>
      </div>
    </div>

            <!-- ===== Add Server Modal ===== -->
    <div class="modal-overlay" v-if="showAddServerModal" @click.self="showAddServerModal=false">
      <div class="modal" style="min-width:520px">
        <h3>添加服务器</h3>

        <div class="modal-row">
          <label>服务器名称</label>
          <input v-model="newServer.name" placeholder="例如: 生产环境Web" style="flex:1">
        </div>
        <div class="modal-row">
          <label>主机地址</label>
          <input v-model="newServer.host" placeholder="IP 或域名" style="flex:1">
        </div>
        <div class="modal-row">
          <label>SSH端口</label>
          <input v-model.number="newServer.ssh_port" type="number" placeholder="22" style="width:100px">
        </div>
        <div class="modal-row">
          <label>SSH用户名</label>
          <input v-model="newServer.ssh_user" placeholder="root" style="flex:1">
        </div>

        <!-- Auth type selection -->
        <div style="margin:12px 0 8px;font-size:13px;color:var(--text2)">登录方式</div>
        <div style="display:flex;gap:12px;margin-bottom:12px">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:var(--text1)">
            <input type="radio" value="password" v-model="newServer.auth_type"> 密码登录
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:var(--text1)">
            <input type="radio" value="key" v-model="newServer.auth_type"> 密钥登录
          </label>
        </div>

        <!-- Password field -->
        <div class="modal-row" v-if="newServer.auth_type==='password'">
          <label>密码</label>
          <input v-model="newServer.ssh_password" type="password" placeholder="SSH密码" style="flex:1">
        </div>

        <!-- SSH Key field -->
        <div v-if="newServer.auth_type==='key'" style="margin-bottom:10px">
          <label style="font-size:13px;color:var(--text2);display:block;margin-bottom:6px">SSH私钥</label>
          <textarea v-model="newServer.ssh_key" placeholder="粘贴私钥内容（以 -----BEGIN 开头）"
            style="width:100%;height:120px;padding:8px;border-radius:6px;border:1px solid var(--border);background:var(--card);color:var(--text1);font-size:12px;font-family:Consolas,monospace;resize:vertical"></textarea>
        </div>

        <!-- Auto deploy Agent -->
        <div class="deploy-auto-row">
          <label>
            <input type="checkbox" v-model="newServer.auto_deploy_agent" checked>
            自动部署监控Agent
          </label>
          <div class="deploy-info">连接成功后自动部署轻量监控程序（端口19100）</div>
        </div>

        <!-- Test result -->
        <div v-if="sshTestResult.message" style="margin:10px 0;padding:8px 12px;border-radius:8px;font-size:13px"
          :style="{
            background: sshTestResult.success ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.1)',
            color: sshTestResult.success ? 'var(--green)' : 'var(--red)',
            border: '1px solid ' + (sshTestResult.success ? 'rgba(34,197,94,.3)' : 'rgba(239,68,68,.3)')
          }">
          {{ sshTestResult.success ? '✓' : '✗' }} {{ sshTestResult.message }}
        </div>

        <div class="modal-footer">
          <button class="btn-sm" @click="testSsh" :disabled="sshTestResult.testing" style="margin-right:auto">
            {{ sshTestResult.testing ? '测试中...' : '测试连接' }}
          </button>
          <button class="btn-sm" @click="showAddServerModal=false;Object.assign(sshTestResult,{testing:false,success:null,message:''});newServer.auto_deploy_agent=true">取消</button>
          <button class="btn-sm primary" @click="addServer">保存</button>
        </div>
      </div>
    </div>

  </div>
</div>
`
}).mount('#app');
</script>
</body>
</html>


