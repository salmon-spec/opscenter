<symbol id="fa-layer-group" viewBox="0 0 576 512"><path fill="currentColor" d="M264.9 29.5l193.1 77.4c9.8 3.9 15.9 13 15.9 23s-6.1 19.1-15.9 23L264.9 230.3c-5.4 2.2-11.4 3.7-17.5 3.7s-12.1-1.5-17.5-3.7L36.8 152.9C27 149 20.9 139.9 20.9 129.9s6.1-19.1 15.9-23L229.9 29.5c5.4-2.2 11.4-3.7 17.5-3.7s12.1 1.5 17.5 3.7zM42.9 211.6l36.3 14.6L36.8 257.1c-9.8 3.9-15.9 13-15.9 23s6.1 19.1 15.9 23L36.8 308c-9.8 3.9-15.9 13-15.9 23s6.1 19.1 15.9 23l193.1 77.4c5.4 2.2 11.4 3.7 17.5 3.7s12.1-1.5 17.5-3.7l193.1-77.4c9.8-3.9 15.9-13 15.9-23s-6.1-19.1-15.9-23l.1-5.9c9.8-3.9 15.9-13 15.9-23s-6.1-19.1-15.9-23l-42.4-30.9 36.3-14.6c5.7-2.3 9.4-7.7 9.4-13.8s-3.7-11.5-9.4-13.8l-52.3-21c-7.9-3.2-16.6-2.3-23.7 2.4l-56 38.3-56-38.3c-7.1-4.7-15.8-5.6-23.7-2.4l-52.3 21c-5.7 2.3-9.4 7.7-9.4 13.8s3.7 11.5 9.4 13.8z"/></symbol>
