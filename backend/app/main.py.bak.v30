# Stub functions for discovery capabilities not yet in discovery module
def discover_listening_ports():
    """Discover listening TCP ports via ss/netstat."""
    import subprocess
    try:
        result = subprocess.run(['ss', '-tlnp'], capture_output=True, text=True, timeout=5)
        ports = []
        for line in result.stdout.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 4:
                local = parts[3] if len(parts) > 3 else ''
                if ':' in local:
                    port_num = int(local.rsplit(':', 1)[-1])
                    proc = parts[-1] if len(parts) > 4 else ''
                    if port_num > 0 and port_num not in [22]:
                        ports.append({'port': port_num, 'service': proc[:30] if proc else f'port-{port_num}'})
        return ports
    except Exception:
        return []

def discover_prometheus_targets():
    """Discover Prometheus scrape targets."""
    import requests as req
    try:
        resp = req.get('http://127.0.0.1:9090/api/v1/targets', timeout=5)
        data = resp.json()
        targets = []
        for t in data.get('data', {}).get('activeTargets', []):
            labels = t.get('labels', {})
            targets.append({'job': labels.get('job', ''), 'instance': labels.get('instance', ''), 'health': t.get('health', '')})
        return targets
    except Exception:
        return []

def discover_systemd_services():
    """Discover active systemd services related to ops."""
    import subprocess
    try:
        result = subprocess.run(['systemctl', 'list-units', '--type=service', '--state=running', '--no-pager', '--no-legend'], capture_output=True, text=True, timeout=5)
        services = []
        for line in result.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 4 and parts[2] == 'running':
                services.append({'name': parts[0], 'description': ' '.join(parts[4:]) if len(parts) > 4 else ''})
        return services
    except Exception:
        return []

