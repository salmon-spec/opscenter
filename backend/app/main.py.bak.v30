    }


# === Stats ===
@app.get("/api/v2/stats")
def get_stats():
    with get_db() as db:
        server_count = db.query(Server).count()
        service_count = db.query(Service).count()
        up_count = db.query(Service).filter(Service.status == ServiceStatus.up.value).count()
        down_count = db.query(Service).filter(Service.status == ServiceStatus.down.value).count()
        return {
            "servers": server_count,
            "services": service_count,
            "up": up_count,
            "down": down_count,
        }


# ============================================================
# OpsCenter v4.0 — New API Endpoints
# ============================================================

@app.get("/api/v2/home")
def get_home():
    """Homepage data: only online/warning and enabled servers with services + stats."""
    with get_db() as db:
        servers = db.query(Server).filter(
            Server.status.in_([ServerStatus.online.value, ServerStatus.warning.value]),
        ).all()
        server_list = []
        total_services = 0
        up_services = 0
        for srv in servers:
            svcs = db.query(Service).filter(Service.server_id == srv.id).all()
            svc_data = []
            for s in svcs:
                total_services += 1
                if s.status == ServiceStatus.up.value:
                    up_services += 1
                svc_data.append({
                    "id": str(s.id),
                    "name": s.name,
                    "url": s.url,
                    "category": s.category,
                    "icon": s.icon,
                    "description": s.description,
                    "source": s.source,
                    "status": s.status,
                    "pinned": s.pinned,
                    "health_path": s.health_path,
                    "container_name": s.container_name,
                    "image": s.image,
                    "ports": s.ports,
                })
            enabled = getattr(srv, "enabled", True)
            if not enabled:
                continue
            server_list.append({
                "id": str(srv.id),
                "name": srv.name,
                "host": srv.host,
                "status": srv.status,
                "is_local": srv.is_local,
                "docker_available": srv.docker_available,
                "last_seen": srv.last_seen.isoformat() if srv.last_seen else None,
                "services": svc_data,
                "service_count": len(svc_data),
            })
        all_servers = db.query(Server).all()
        online_count = sum(1 for s in all_servers if s.status == ServerStatus.online.value)
        return {
            "servers": server_list,
            "stats": {
                "total_servers": len(all_servers),
                "online_servers": online_count,
                "total_services": total_services,
                "up_services": up_services,
            },
        }


@app.get("/api/v2/discovery/status")
def get_discovery_status():
    """Discovery status for all servers."""
    with get_db() as db:
        servers = db.query(Server).all()
        result = []
        for srv in servers:
            svcs = db.query(Service).filter(Service.server_id == srv.id).all()
            sources_used = set()
            for s in svcs:
                if s.source:
                    sources_used.add(s.source)
            discovery_sources = list(sources_used) if sources_used else []
            if srv.docker_available:
                if ServiceSource.docker_auto.value not in discovery_sources:
                    discovery_sources.append(ServiceSource.docker_auto.value)
                if ServiceSource.docker_label.value not in discovery_sources:
                    discovery_sources.append(ServiceSource.docker_label.value)
            result.append({
                "server_id": str(srv.id),
                "server_name": srv.name,
                "status": srv.status,
                "is_local": srv.is_local,
                "service_count": len(svcs),
                "discovery_sources": discovery_sources,
                "last_seen": srv.last_seen.isoformat() if srv.last_seen else None,
            })
        return result


@app.post("/api/v2/discovery/run")
def run_discovery(data: DiscoveryRunRequest):
    """Trigger a scan/discovery on a server."""
    from app.discovery import classify_image, get_icon, get_desc, get_url
    with get_db() as db:
        if data.server_id:
            srv = db.query(Server).filter(Server.id == uuid.UUID(data.server_id)).first()
            if not srv:
                raise HTTPException(404, "Server not found")
            targets = [srv]
        else:
            targets = db.query(Server).all()

        total_discovered = 0
        results = []

        for srv in targets:
            discovered_count = 0
            errors = []

            if srv.is_local:
                try:
                    disc = discover_docker_services(srv, db, srv.host)
                    discovered_count += len(disc)
                except Exception as e:
                    errors.append(str(e))
                try:
                    routes = parse_nginx_config(host=srv.host)
                    for route in routes:
                        existing = db.query(Service).filter(
                            Service.server_id == srv.id,
                            Service.url == route["url"],
                        ).first()
                        if not existing:
                            svc = Service(
                                server_id=srv.id,
                                name=route["name"],
                                url=route["url"],
                                source=ServiceSource.nginx.value,
                                category="未分类",
                                icon="fa-globe",
                                status=ServiceStatus.unknown.value,
                            )
                            db.add(svc)
                            discovered_count += 1
                    db.commit()
                except Exception as e:
                    errors.append(str(e))
                try:
                    ports = discover_listening_ports()
                    for p in ports:
                        existing = db.query(Service).filter(
                            Service.server_id == srv.id,
                            Service.container_name == f"port-{p['port']}",
                        ).first()
                        if not existing:
                            svc = Service(
                                server_id=srv.id,
                                name=p.get("service", f"Port {p['port']}"),
                                url=f"http://{srv.host}:{p['port']}/",
                                source=ServiceSource.port.value if hasattr(ServiceSource, 'port') else "port",
                                category="未分类",
                                icon="fa-plug",
                                status=ServiceStatus.unknown.value,
                                container_name=f"port-{p['port']}",
                            )
                            db.add(svc)
                            discovered_count += 1
                    db.commit()
                except Exception as e:
                    errors.append(str(e))
            else:
                password = None
                if srv.ssh_key and srv.ssh_key.startswith("__password__"):
                    password = srv.ssh_key[len("__password__"):]
                client = get_ssh_client(srv, password=password)
                if not client:
                    errors.append("Cannot connect via SSH")
                else:
                    try:
                        containers = discover_remote_docker_services(client, host=srv.host)
                        for c in containers:
                            name = c.get("name", "")
                            image = c.get("image", "")
                            status_str = c.get("status", "")
                            ports_str = c.get("ports", "")
                            is_running = "Up" in status_str
                            short_image = image.split(":")[0].split("/")[-1] if image else ""
                            svc_name = name.replace("-", " ").replace("_", " ").title()
                            svc_url = c.get("auto_url", "") or get_url(name, srv.host) or ""
                            svc_category = classify_image(short_image)
                            svc_icon = get_icon(short_image)
                            svc_desc = get_desc(short_image, name)
                            if not svc_url:
                                continue
                            existing = db.query(Service).filter(
                                Service.server_id == srv.id,
                                Service.container_name == name,
                            ).first()
                            if existing:
                                for fld, val in [("name", svc_name), ("url", svc_url), ("category", svc_category), ("icon", svc_icon), ("description", svc_desc), ("image", image), ("ports", ports_str)]:
                                    if val and getattr(existing, fld) != val:
                                        setattr(existing, fld, val)
                                existing.status = ServiceStatus.up.value if is_running else ServiceStatus.down.value
                            else:
                                svc = Service(
                                    server_id=srv.id, name=svc_name, url=svc_url,
                                    category=svc_category, icon=svc_icon, description=svc_desc,
                                    source=ServiceSource.docker_auto.value,
                                    status=ServiceStatus.up.value if is_running else ServiceStatus.down.value,
                                    container_name=name, image=image, ports=ports_str,
                                )
                                db.add(svc)
                            discovered_count += 1
                        srv.status = ServerStatus.online.value
                        srv.last_seen = datetime.utcnow()
                        srv.docker_available = True
                        db.commit()
                    except Exception as e:
                        errors.append(str(e))
                    finally:
                        try:
                            client.close()
                        except Exception:
                            pass

            total_discovered += discovered_count
            results.append({
                "server_id": str(srv.id),
                "server_name": srv.name,
                "discovered": discovered_count,
                "errors": errors,
            })

        return {"total_discovered": total_discovered, "results": results}


@app.get("/api/v2/monitor/{server_id}/containers")
def get_containers(server_id: str):
    """Get container list for a server."""
    with get_db() as db:
        srv = db.query(Server).filter(Server.id == uuid.UUID(server_id)).first()
        if not srv:
            raise HTTPException(404, "Server not found")

    if srv.is_local:
        try:
            import docker as docker_sdk
            dc = docker_sdk.from_env()
            container_list = []
            for c in dc.containers.list(all=True):
                ports = []
                for p in c.ports.values():
                    if p and isinstance(p, list):
                        for binding in p:
                            ports.append(f"{binding.get('HostIp', '0.0.0.0')}:{binding.get('HostPort', '?')}")
                container_list.append({
                    "name": c.name,
                    "image": c.image.tags[0] if c.image.tags else str(c.image.id[:12]),
                    "status": c.status,
                    "ports": ", ".join(ports) if ports else "-",
                    "container_id": c.short_id,
                    "created": str(c.attrs.get("Created", "")),
                    "networks": list(c.attrs.get("NetworkSettings", {}).get("Networks", {}).keys()),
                })
            return {"server_id": server_id, "containers": container_list}
        except Exception as e:
            return {"server_id": server_id, "containers": [], "error": str(e)}
    else:
        password = None
        if srv.ssh_key and srv.ssh_key.startswith("__password__"):
            password = srv.ssh_key[len("__password__"):]
        client = get_ssh_client(srv, password=password)
        if not client:
            return {"server_id": server_id, "containers": [], "error": "Cannot connect via SSH"}
        try:
            containers = get_remote_containers(client)
            return {"server_id": server_id, "containers": containers}
        except Exception as e:
            return {"server_id": server_id, "containers": [], "error": str(e)}
        finally:
            try:
                client.close()
            except Exception:
                pass


@app.get("/api/v2/monitor/{server_id}/disks")
def get_disks(server_id: str):
    """Get disk/filesystem info for a server."""
    with get_db() as db:
        srv = db.query(Server).filter(Server.id == uuid.UUID(server_id)).first()
        if not srv:
            raise HTTPException(404, "Server not found")

    if srv.is_local:
        try:
            import psutil
            disks = []
            for part in psutil.disk_partitions(all=False):
                try:
                    usage = psutil.disk_usage(part.mountpoint)
                    disks.append({
                        "device": part.device,
                        "mountpoint": part.mountpoint,
                        "fstype": part.fstype,
                        "total": usage.total,
                        "used": usage.used,
                        "free": usage.free,
                        "percent": usage.percent,
                    })
                except PermissionError:
                    continue
            return {"server_id": server_id, "disks": disks}
        except ImportError:
            return {"server_id": server_id, "disks": [], "error": "psutil not installed"}
        except Exception as e:
            return {"server_id": server_id, "disks": [], "error": str(e)}
    else:
        password = None
        if srv.ssh_key and srv.ssh_key.startswith("__password__"):
            password = srv.ssh_key[len("__password__"):]
        client = get_ssh_client(srv, password=password)
        if not client:
            return {"server_id": server_id, "disks": [], "error": "Cannot connect via SSH"}
        try:
            output = ssh_exec(client, "df -B1 --output=source,target,fstype,size,used,avail,pcent | tail -n +2")
            disks = []
            for line in output.strip().splitlines():
                parts = line.strip().split()
                if len(parts) >= 7:
                    pct = parts[6].replace("%", "")
                    disks.append({
                        "device": parts[0],
                        "mountpoint": parts[1],
                        "fstype": parts[2],
                        "total": int(parts[3]),
                        "used": int(parts[4]),
                        "free": int(parts[5]),
                        "percent": int(pct),
                    })
            return {"server_id": server_id, "disks": disks}
        except Exception as e:
            return {"server_id": server_id, "disks": [], "error": str(e)}
        finally:
            try:
                client.close()
            except Exception:
                pass


@app.get("/api/v2/monitor/{server_id}/network")
def get_network(server_id: str):
    """Get network I/O stats for a server."""
    with get_db() as db:
        srv = db.query(Server).filter(Server.id == uuid.UUID(server_id)).first()
        if not srv:
            raise HTTPException(404, "Server not found")

    if srv.is_local:
        try:
            import psutil
            net_io = psutil.net_io_counters()
            net_per_nic = psutil.net_io_counters(pernic=True)
            interfaces = []
            for iface, counters in net_per_nic.items():
                if iface == "lo":
                    continue
                interfaces.append({
                    "interface": iface,
                    "bytes_sent": counters.bytes_sent,
                    "bytes_recv": counters.bytes_recv,
                    "packets_sent": counters.packets_sent,
                    "packets_recv": counters.packets_recv,
                    "errin": counters.errin,
                    "errout": counters.errout,
                    "dropin": counters.dropin,
                    "dropout": counters.dropout,
                })
            return {
                "server_id": server_id,
                "total": {
                    "bytes_sent": net_io.bytes_sent,
                    "bytes_recv": net_io.bytes_recv,
                    "packets_sent": net_io.packets_sent,
                    "packets_recv": net_io.packets_recv,
                },
                "interfaces": interfaces,
            }
        except ImportError:
            return {"server_id": server_id, "error": "psutil not installed", "interfaces": []}
        except Exception as e:
            return {"server_id": server_id, "error": str(e), "interfaces": []}
    else:
        password = None
        if srv.ssh_key and srv.ssh_key.startswith("__password__"):
            password = srv.ssh_key[len("__password__"):]
        client = get_ssh_client(srv, password=password)
        if not client:
            return {"server_id": server_id, "error": "Cannot connect via SSH", "interfaces": []}
        try:
            output = ssh_exec(client, "cat /proc/net/dev | tail -n +3")
            interfaces = []
            for line in output.strip().splitlines():
                line = line.strip()
                if ":" not in line:
                    continue
                iface, data = line.split(":", 1)
                iface = iface.strip()
                if iface == "lo":
                    continue
                parts = data.strip().split()
                if len(parts) >= 16:
                    interfaces.append({
                        "interface": iface,
                        "bytes_recv": int(parts[0]),
                        "packets_recv": int(parts[1]),
                        "errin": int(parts[2]),
                        "dropin": int(parts[3]),
                        "bytes_sent": int(parts[8]),
                        "packets_sent": int(parts[9]),
                        "errout": int(parts[10]),
                        "dropout": int(parts[11]),
                    })
            total_rx = sum(i.get("bytes_recv", 0) for i in interfaces)
            total_tx = sum(i.get("bytes_sent", 0) for i in interfaces)
            return {
                "server_id": server_id,
                "total": {"bytes_sent": total_tx, "bytes_recv": total_rx},
                "interfaces": interfaces,
            }
        except Exception as e:
            return {"server_id": server_id, "error": str(e), "interfaces": []}
        finally:
            try:
                client.close()
            except Exception:
                pass


@app.post("/api/v2/servers/{server_id}/check")
def check_server(server_id: str):
    """Check if a server is reachable, update status in DB."""
    with get_db() as db:
        srv = db.query(Server).filter(Server.id == uuid.UUID(server_id)).first()
        if not srv:
            raise HTTPException(404, "Server not found")

        if srv.is_local:
            srv.status = ServerStatus.online.value
            srv.last_seen = datetime.utcnow()
            db.commit()
            return {"server_id": server_id, "status": "online", "message": "Local server is always accessible"}

        reachable = False
        message = ""
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(5)
            result = sock.connect_ex((srv.host, srv.ssh_port or 22))
            sock.close()
            if result == 0:
                reachable = True
                message = f"TCP connection to {srv.host}:{srv.ssh_port or 22} successful"
            else:
                message = f"TCP connection to {srv.host}:{srv.ssh_port or 22} failed (errno={result})"
        except Exception as e:
            message = f"Connection error: {e}"

        if reachable:
            srv.status = ServerStatus.online.value
            srv.last_seen = datetime.utcnow()
        else:
            srv.status = ServerStatus.offline.value
        db.commit()

        return {"server_id": server_id, "status": srv.status, "message": message}


@app.post("/api/v2/servers/{server_id}/enable")
def enable_server(server_id: str):
    """Set server.enabled = True."""
    with get_db() as db:
        srv = db.query(Server).filter(Server.id == uuid.UUID(server_id)).first()
        if not srv:
            raise HTTPException(404, "Server not found")
        if hasattr(srv, "enabled"):
            srv.enabled = True
        db.commit()
        return {"ok": True, "server_id": server_id, "enabled": True}


@app.post("/api/v2/servers/{server_id}/disable")
def disable_server(server_id: str):
    """Set server.enabled = False."""
    with get_db() as db:
        srv = db.query(Server).filter(Server.id == uuid.UUID(server_id)).first()
        if not srv:
            raise HTTPException(404, "Server not found")
        if hasattr(srv, "enabled"):
            srv.enabled = False
        db.commit()
        return {"ok": True, "server_id": server_id, "enabled": False}

