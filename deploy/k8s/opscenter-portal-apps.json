{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "portal-app-gateway",
        "namespace": "opscenter"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          }
        },
        "selector": {
          "matchLabels": {
            "app": "portal-app-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "portal-app-gateway"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/hostname": "k8s-master-01"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "effect": "NoSchedule",
                "operator": "Exists"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001
            },
            "containers": [
              {
                "name": "gateway",
                "image": "opscenter/portal-app-gateway:0.1.0",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "jenkins",
                    "containerPort": 8081
                  },
                  {
                    "name": "forgejo",
                    "containerPort": 8082
                  },
                  {
                    "name": "nexus",
                    "containerPort": 8083
                  },
                  {
                    "name": "sonarqube",
                    "containerPort": 8084
                  },
                  {
                    "name": "grafana",
                    "containerPort": 8085
                  },
                  {
                    "name": "minio",
                    "containerPort": 8086
                  },
                  {
                    "name": "nacos",
                    "containerPort": 8087
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/config"
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8099
                  },
                  "initialDelaySeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8099
                  },
                  "initialDelaySeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "emptyDir": {
                  "sizeLimit": "4Mi"
                }
              },
              {
                "name": "data",
                "emptyDir": {
                  "sizeLimit": "4Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "portal-app-gateway",
        "namespace": "opscenter"
      },
      "spec": {
        "type": "NodePort",
        "externalTrafficPolicy": "Local",
        "selector": {
          "app": "portal-app-gateway"
        },
        "ports": [
          {
            "name": "jenkins",
            "port": 8081,
            "targetPort": 8081,
            "nodePort": 30093
          },
          {
            "name": "forgejo",
            "port": 8082,
            "targetPort": 8082,
            "nodePort": 30094
          },
          {
            "name": "nexus",
            "port": 8083,
            "targetPort": 8083,
            "nodePort": 30095
          },
          {
            "name": "sonarqube",
            "port": 8084,
            "targetPort": 8084,
            "nodePort": 30096
          },
          {
            "name": "grafana",
            "port": 8085,
            "targetPort": 8085,
            "nodePort": 30097
          },
          {
            "name": "minio",
            "port": 8086,
            "targetPort": 8086,
            "nodePort": 30098
          },
          {
            "name": "nacos",
            "port": 8087,
            "targetPort": 8087,
            "nodePort": 30099
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "portal-app-gateway-ingress",
        "namespace": "opscenter"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "portal-app-gateway"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "ipBlock": {
                  "cidr": "10.66.66.0/24"
                }
              },
              {
                "ipBlock": {
                  "cidr": "192.168.1.0/24"
                }
              }
            ],
            "ports": [
              {
                "port": 8081,
                "protocol": "TCP"
              },
              {
                "port": 8082,
                "protocol": "TCP"
              },
              {
                "port": 8083,
                "protocol": "TCP"
              },
              {
                "port": 8084,
                "protocol": "TCP"
              },
              {
                "port": 8085,
                "protocol": "TCP"
              },
              {
                "port": 8086,
                "protocol": "TCP"
              },
              {
                "port": 8087,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ]
}
