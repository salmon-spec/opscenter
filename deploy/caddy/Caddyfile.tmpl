{
    auto_https disable_redirects
}

# Ops Center (MFA host local)
ops.salmon.xin:80 {
    # /status/ 与 /status-page* 匿名放行（S3 状态页，仅聚合摘要）
    handle /status/* {
        root * /opt/opscenter/frontend
        rewrite * /status.html
        file_server
    }
    handle /status-page* {
        reverse_proxy localhost:9091
    }
    # 其余路径（前端静态 + API + WS）全部 basic_auth
    handle /api/v2/status-page {
        reverse_proxy localhost:9091
    }
    handle /api/* {
        
        reverse_proxy localhost:9091
    }
    handle /ws/* {
        
        reverse_proxy localhost:9091
    }
    handle {
        
        root * /opt/opscenter/frontend
        file_server
    }
}
