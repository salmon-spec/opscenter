    handle_path /modules/alerts/* {
        @internalProbe path /health/* /metrics /openapi.json /docs /docs/* /redoc /redoc/*
        respond @internalProbe 404
        reverse_proxy module-alerts:8080
    }
    handle_path /modules/logs/* {
        @internalProbe path /health/* /metrics /openapi.json /docs /docs/* /redoc /redoc/*
        respond @internalProbe 404
        reverse_proxy module-logs:8080
    }
