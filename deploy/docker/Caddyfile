:80 {
    encode zstd gzip

    handle /api/* {
        @legacyAlerts path /api/v2/alert-rules /api/v2/alert-rules/* /api/v2/alert-events /api/v2/alert-events/* /api/v2/alert-silences /api/v2/alert-silences/*
        respond @legacyAlerts `{"detail":"告警功能已迁移至 alerts 模块"}` 410
        @ossExtension path /api/v2/modules/oss-browser/health /api/v2/modules/oss-browser/status /api/v2/modules/oss-browser/config /api/v2/modules/oss-browser/config/* /api/v2/modules/oss-browser/objects /api/v2/modules/oss-browser/summary /api/v2/modules/oss-browser/preview /api/v2/modules/oss-browser/download
        reverse_proxy @ossExtension module-oss-browser:8080
        @modelExtension path /api/v2/modules/command-code-usage/health /api/v2/modules/command-code-usage/status /api/v2/modules/command-code-usage/config /api/v2/modules/command-code-usage/config/*
        reverse_proxy @modelExtension module-command-code-usage:8080
        reverse_proxy backend:9091
    }
    handle_path /modules/k3s/* {
        @internalProbe path /health/* /metrics /openapi.json /docs /docs/* /redoc /redoc/*
        respond @internalProbe 404
        reverse_proxy module-k3s:8080
