:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:9091
    }
    handle /ws/* {
        reverse_proxy backend:9091
    }
    @apiDocs path /openapi.json /docs /docs/* /redoc /redoc/*
    handle @apiDocs {
        reverse_proxy backend:9091
    }
    @versionedAssets path /v3/assets/*
    header @versionedAssets Cache-Control "public, max-age=31536000, immutable"
    handle /v3/* {
        root * /srv
        file_server
    }
    handle {
        rewrite * /v3/index.html
        root * /srv
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}
