{
    admin off
    auto_https off
    persist_config off
}
:8099 {
    handle /health/live {
        respond "ok" 200
    }
    handle /health/ready {
        respond "ok" 200
    }
    handle {
        respond 404
    }
}

:8081 {
    reverse_proxy http://10.66.66.13:8084 {
        header_up -Forwarded
        header_up X-Forwarded-Host 10.66.66.13:30093
        header_up X-Forwarded-Port 30093
        header_down -X-Frame-Options
        header_down Content-Security-Policy "(?i)frame-ancestors[^;]*(;|$)" ""
        header_down +Content-Security-Policy "frame-ancestors 'self' http://10.66.66.13:30092"
        header_down Location "^http://10\\.66\\.66\\.13:8084(/.*)?$" "http://10.66.66.13:30093$1"
    }
}

