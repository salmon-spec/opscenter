{
    admin off
    auto_https off
    persist_config off
}
:8099 {
    handle /health/live {
        respond "ok" 200
    }
    handle /health/ready {
        respond "ok" 200
    }
    handle {
        respond 404
    }
}

:8087 {
    header +Content-Security-Policy "frame-ancestors 'self' http://10.66.66.13:30092"
    handle / {
        header Content-Type "text/html; charset=utf-8"
        respond "<!doctype html><html lang='zh-CN'><meta charset='utf-8'><title>Nacos</title><style>html,body,iframe{width:100%;height:100%;margin:0;border:0;display:block}</style><iframe title='Nacos 应用'></iframe><script src='/portal-shell.js'></script></html>" 200
    }
    handle /portal-shell.js {
        header Content-Type "application/javascript"
        respond "fetch('/nacos/',{credentials:'same-origin'}).then(r=>{if(!r.ok)throw Error('Nacos 页面读取失败');return r.text()}).then(html=>{document.querySelector('iframe').srcdoc='<meta http-equiv=\"Content-Security-Policy\" content=\"script-src &#39;self&#39;\"><base href=\"/nacos/\">'+html}).catch(e=>{document.body.textContent=e.message})" 200
    }
    handle /nacos/* {
        reverse_proxy http://10.66.66.13:8848
    }
    handle {
        respond 404
    }
}

:8081 {
    header {
        +Content-Security-Policy "frame-ancestors 'self' http://10.66.66.13:30092"
        defer
    }
    reverse_proxy http://10.66.66.13:8084 {
        header_up -Forwarded
        header_up X-Forwarded-Host 10.66.66.13:30093
        header_up X-Forwarded-Port 30093
        header_down -X-Frame-Options
        header_down Content-Security-Policy "(?i)frame-ancestors[^;]*(;|$)" ""
        header_down Location "^http://10\\.66\\.66\\.13:8084(/.*)?$" "http://10.66.66.13:30093$1"
    }
}

