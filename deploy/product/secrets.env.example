# Copy to /etc/opscenter/secrets.env and chmod 600.
POSTGRES_DB=opscenter
POSTGRES_USER=opscenter
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATA_DIR=/opt/opscenter-data/postgres
DATABASE_URL=postgresql+psycopg://opscenter:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5433/opscenter

OPS_AUTH_ENABLED=false
OPS_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
OPS_ADMIN_USER=admin
OPS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
CREDENTIAL_KEY=CHANGE_ME_STABLE_CREDENTIAL_KEY
LOCAL_AGENT_TOKEN=CHANGE_ME_RANDOM_AGENT_TOKEN
LOCAL_HOST=127.0.0.1
LOCAL_SERVER_NAME=OpsCenter
OPSCENTER_1PANEL_ENTRY_URL=

PREVIEW_MODE=false
LOKI_URL=http://127.0.0.1:3100
LOKI_RETENTION_DAYS=365
LOKI_DATA_DIR=/opt/opscenter-data/loki
