:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:9091
    }
    handle /ws/* {
        reverse_proxy 127.0.0.1:9091
    }
    handle {
        @html path / /index.html
        header @html Cache-Control "no-cache, no-store, must-revalidate"
        root * /opt/opscenter/frontend/v3
        try_files {path} /index.html
        file_server
    }
}
